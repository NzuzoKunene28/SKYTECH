@model IEnumerable<SkyTech.Models.LeaseAgreement>
@{
    ViewData["Title"] = "Ready for Refund";

    string StageLabel(SkyTech.Models.LeaseReturnStatus s) => s switch
    {
        SkyTech.Models.LeaseReturnStatus.Return_Pending => "Awaiting collection",
        SkyTech.Models.LeaseReturnStatus.Collection_Assigned => "Driver assigned",
        SkyTech.Models.LeaseReturnStatus.Item_Collected => "Received - not yet confirmed",
        SkyTech.Models.LeaseReturnStatus.Inspection_Complete => "Inspected",
        SkyTech.Models.LeaseReturnStatus.Completed => "Completed",
        _ => s.ToString()
    };

    string StageClass(SkyTech.Models.LeaseReturnStatus s) => s switch
    {
        SkyTech.Models.LeaseReturnStatus.Return_Pending => "stage-pending",
        SkyTech.Models.LeaseReturnStatus.Collection_Assigned => "stage-pending",
        SkyTech.Models.LeaseReturnStatus.Item_Collected => "stage-progress",
        SkyTech.Models.LeaseReturnStatus.Inspection_Complete => "stage-ready",
        SkyTech.Models.LeaseReturnStatus.Completed => "stage-done",
        _ => "stage-pending"
    };

    var inProgress = ViewBag.InProgress as List<SkyTech.Models.LeaseAgreement> ?? new List<SkyTech.Models.LeaseAgreement>();
}

<style>
    .rfr-page { padding: 32px 20px 60px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; max-width: 1080px; margin: 0 auto; color: #1b2a2f; }
    .rfr-title { font-weight: 800; font-size: 1.4rem; margin: 0 0 4px; }
    .rfr-subtitle { color: #6b8481; font-size: 0.9rem; margin: 0 0 20px; }
    .rfr-msg { background: #eafaf0; border: 1px solid #bfe7cd; color: #1e7a44; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.9rem; animation: rfr-slide-in .3s ease; }
    .rfr-error { background: #fdeceb; border: 1px solid #f3bcb9; color: #b3261e; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.9rem; animation: rfr-slide-in .3s ease; }

    .rfr-section-title { font-weight: 700; font-size: 1.02rem; margin: 32px 0 4px; display: flex; align-items: center; gap: 8px; }
    .rfr-section-sub { color: #6b8481; font-size: 0.85rem; margin: 0 0 14px; }

    .rfr-card {
        background: #fff; border-radius: 16px; box-shadow: 0 6px 20px rgba(0,0,0,0.07);
        margin-bottom: 16px; overflow: hidden; opacity: 0; transform: translateY(14px);
        animation: rfr-fade-up .45s ease forwards;
    }
    .rfr-card:hover { box-shadow: 0 10px 28px rgba(61,120,115,0.18); }
    .rfr-card-head {
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;
        padding: 16px 20px; background: #f7fbfa; border-bottom: 1px solid #eef1f0;
    }
    .rfr-card-id { font-weight: 800; font-size: 1.02rem; }
    .rfr-card-customer { color: #6b8481; font-size: 0.86rem; }

    .rfr-money-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; padding: 16px 20px; }
    .rfr-money-item { display: flex; flex-direction: column; gap: 2px; }
    .rfr-money-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.4px; color: #6b8481; font-weight: 700; }
    .rfr-money-value { font-size: 1.05rem; font-weight: 700; }
    .rfr-money-value.total { color: #17845a; }

    table.rfr-items { width: 100%; border-collapse: collapse; }
    table.rfr-items th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.3px; color: #6b8481; padding: 8px 20px; background: #fafcfc; border-top: 1px solid #eef1f0; border-bottom: 1px solid #eef1f0; }
    table.rfr-items td { padding: 10px 20px; font-size: 0.88rem; border-bottom: 1px solid #f3f5f4; }
    table.rfr-items tr:last-child td { border-bottom: none; }

    .rfr-stage { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 700; }
    .stage-pending { background: #fdf0dc; color: #a35c00; }
    .stage-progress { background: #dcf0ef; color: #3d7873; }
    .stage-ready { background: #eafaf0; color: #1e7a44; }
    .stage-done { background: #e6e9ec; color: #445; }

    .rfr-actions { padding: 14px 20px 18px; }
    .rfr-btn { padding: 10px 22px; border-radius: 999px; border: none; background: linear-gradient(135deg,#4a8f8c,#3d7873); color: #fff; font-weight: 700; font-size: 0.86rem; cursor: pointer; transition: filter .15s ease, transform .1s ease; }
    .rfr-btn:hover { filter: brightness(1.08); }
    .rfr-btn:active { transform: scale(0.97); }
    .rfr-btn[disabled] { opacity: 0.7; cursor: wait; }

    .rfr-empty { text-align: center; padding: 50px 20px; color: #6b8481; background: #fff; border-radius: 16px; box-shadow: 0 6px 20px rgba(0,0,0,0.06); }

    .rfr-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; animation: rfr-spin .7s linear infinite; margin-right: 8px; vertical-align: -2px; }

    @@keyframes rfr-fade-up { to { opacity: 1; transform: translateY(0); } }
    @@keyframes rfr-slide-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
    @@keyframes rfr-spin { to { transform: rotate(360deg); } }
</style>

<div class="rfr-page">
    <div class="rfr-title">Ready for Refund</div>
    <div class="rfr-subtitle">Agreements where every item has finished inspection and a deposit refund can be processed.</div>

    @if (TempData["Message"] != null)
    {
        <div class="rfr-msg">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rfr-error">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="rfr-empty">No agreements are fully inspected and ready for a refund right now.</div>
    }
    else
    {
        int delay = 0;
        @foreach (var agreement in Model)
        {
            double deposit = agreement.Items.Sum(i => i.DepositAtLease);
            double damage = agreement.Items.Sum(i => i.DamageFee ?? 0);
            double earlyFee = agreement.Items.Sum(i => i.EarlyReturnFee ?? 0);
            double refund = Math.Max(0, deposit - damage - earlyFee);

            <div class="rfr-card" style="animation-delay:@(delay)ms;">
                <div class="rfr-card-head">
                    <div>
                        <div class="rfr-card-id">Agreement #@agreement.LeaseAgreementId</div>
                        <div class="rfr-card-customer">@agreement.Customer?.FirstName @agreement.Customer?.LastName &middot; @agreement.Customer?.Email</div>
                    </div>
                </div>

                <div class="rfr-money-row">
                    <div class="rfr-money-item"><span class="rfr-money-label">Deposit Held</span><span class="rfr-money-value">R@(deposit.ToString("N2"))</span></div>
                    <div class="rfr-money-item"><span class="rfr-money-label">Damage Fees</span><span class="rfr-money-value">R@(damage.ToString("N2"))</span></div>
                    <div class="rfr-money-item"><span class="rfr-money-label">Early Return Fee</span><span class="rfr-money-value">R@(earlyFee.ToString("N2"))</span></div>
                    <div class="rfr-money-item"><span class="rfr-money-label">Refund Due</span><span class="rfr-money-value total">R@(refund.ToString("N2"))</span></div>
                </div>

                <table class="rfr-items">
                    <thead>
                        <tr><th>Item</th><th>Serial</th><th>Condition</th><th>Stage</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in agreement.Items)
                        {
                            <tr>
                                <td>@(item.LeaseUnit?.LeaseProduct?.LeaseProdName ?? "-")</td>
                                <td>@item.LeaseUnit?.SerialNumber</td>
                                <td>@(item.AiDamageAssessment?.ToString() ?? item.ConditionAtReturn ?? "-")</td>
                                <td><span class="rfr-stage @StageClass(item.ReturnStatus)">@StageLabel(item.ReturnStatus)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="rfr-actions">
                    <form method="post" action="@Url.Action("ProcessDepositRefund")" class="rfr-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="leaseAgreementId" value="@agreement.LeaseAgreementId" />
                        <button type="submit" class="rfr-btn">Process Refund</button>
                    </form>
                </div>
            </div>
            delay += 60;
        }
    }

    @if (inProgress.Any())
    {
        <div class="rfr-section-title"><i class="fas fa-hourglass-half"></i> Returns in progress</div>
        <div class="rfr-section-sub">Not ready yet &mdash; every item on the agreement needs to reach "Inspected" first.</div>

        @foreach (var agreement in inProgress)
        {
            int total = agreement.Items.Count;
            int done = agreement.Items.Count(i => i.ReturnStatus == SkyTech.Models.LeaseReturnStatus.Inspection_Complete);

            <div class="rfr-card">
                <div class="rfr-card-head">
                    <div>
                        <div class="rfr-card-id">Agreement #@agreement.LeaseAgreementId</div>
                        <div class="rfr-card-customer">@agreement.Customer?.FirstName @agreement.Customer?.LastName &middot; @done of @total items inspected</div>
                    </div>
                </div>
                <table class="rfr-items">
                    <thead>
                        <tr><th>Item</th><th>Serial</th><th>Stage</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in agreement.Items)
                        {
                            <tr>
                                <td>@(item.LeaseUnit?.LeaseProduct?.LeaseProdName ?? "-")</td>
                                <td>@item.LeaseUnit?.SerialNumber</td>
                                <td><span class="rfr-stage @StageClass(item.ReturnStatus)">@StageLabel(item.ReturnStatus)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

<script>
    document.querySelectorAll('.rfr-form').forEach(form => {
        form.addEventListener('submit', () => {
            const btn = form.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="rfr-spinner"></span> Processing...';
        });
    });
</script>
