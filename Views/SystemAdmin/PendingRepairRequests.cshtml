@model List<Repair_Request>
@{
    ViewBag.Title = "Pending Repair Requests";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "RepairRequests";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DashboardStyle.css">
    <style>
        .status-badge {
            display: inline-block;
            padding: 0.4rem 0.8rem;
            border-radius: var(--radius-pill);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-pending { background: #fef3c7; color: #92400e; }
        .status-assigned { background: #dbeafe; color: #0c4a6e; }
        .repair-table { width: 100%; border-collapse: collapse; }
        .repair-table th {
            background: var(--blue-soft);
            padding: 1rem;
            text-align: left;
            color: var(--text);
            font-weight: 600;
            border-bottom: 2px solid var(--border);
        }
        .repair-table td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
        }
        .repair-table tr:hover { background: rgba(95,158,160,.05); }
        .action-btn {
            padding: 0.5rem 1rem;
            border-radius: var(--radius-sm);
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
        }
        .btn-assign {
            background: var(--blue);
            color: white;
        }
        .btn-assign:hover {
            background: var(--blue-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }
        .btn-view {
            background: transparent;
            color: var(--blue);
            border: 1px solid var(--blue);
        }
        .btn-view:hover {
            background: var(--blue-soft);
        }
    </style>
}

<div class="dash-wrap">
    <!-- ══ SIDEBAR ══ -->
    <aside class="dash-sidebar">
        <div class="dash-brand">
            <div class="dash-brand-icon"><i class="fas fa-lock-open"></i></div>
            <div>
                <div class="dash-brand-name">SkyTech</div>
                <div class="dash-brand-sub">Admin Portal</div>
            </div>
        </div>
        <nav class="dash-nav">
            <div class="dash-nav-label">SYSTEM</div>
            <a href="@Url.Action("SystemAdminDash", "SystemAdmin")" class="dash-link">
                <i class="fas fa-chart-pie"></i><span>Dashboard</span>
            </a>

            <div class="dash-nav-label">REPAIR MANAGEMENT</div>
            <a href="@Url.Action("PendingRepairRequests", "SystemAdmin")" class="dash-link active">
                <i class="fas fa-clock"></i><span>Pending Requests</span>
            </a>
            <a href="@Url.Action("AllRepairRequests", "SystemAdmin")" class="dash-link">
                <i class="fas fa-list"></i><span>All Requests</span>
            </a>

            <div class="dash-nav-label">APPLICATIONS</div>
            <a href="@Url.Action("ViewApplications", "SystemAdmin")" class="dash-link">
                <i class="fas fa-building"></i><span>Shop Owners</span>
            </a>
            <a href="@Url.Action("ViewDriverApplication", "SystemAdmin")" class="dash-link">
                <i class="fas fa-truck"></i><span>Drivers</span>
            </a>
        </nav>

        <div class="dash-sidebar-foot">
            <div class="dash-foot-avatar"><i class="fas fa-shield"></i></div>
            <div>
                <div class="dash-foot-name">System Admin</div>
                <div class="dash-foot-role">Administrator</div>
            </div>
        </div>

        <div style="padding:.8rem 1.2rem;margin-top:1rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="dash-logout-btn">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </button>
            }
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <main class="dash-main">
        <div class="dash-header">
            <div>
                <h1 class="dash-title">Pending Repair Requests</h1>
                <p class="dash-subtitle">Manage and assign repair requests to technicians</p>
            </div>
        </div>

        <div class="dash-content">
            @if (Model.Count == 0)
            {
                <div class="dash-card" style="padding: 2rem; text-align: center;">
                    <i class="fas fa-check-circle" style="font-size: 3rem; color: var(--green); margin-bottom: 1rem;"></i>
                    <p style="color: var(--text-muted);">No pending repair requests at this time.</p>
                </div>
            }
            else
            {
                <div class="dash-card">
                    <table class="repair-table">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Customer</th>
                                <th>Item</th>
                                <th>Issue</th>
                                <th>Category</th>
                                <th>Date Created</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var repair in Model)
                            {
                                <tr>
                                    <td><strong>#@repair.RequestId</strong></td>
                                    <td>@repair.Customers?.FirstName @repair.Customers?.LastName</td>
                                    <td>@repair.ItemName</td>
                                    <td>@repair.IssueDescription</td>
                                    <td>@repair.Category?.CategoryName</td>
                                    <td>@repair.DateCreated.ToString("MMM dd, yyyy")</td>
                                    <td><span class="status-badge status-pending">@repair.Status</span></td>
                                    <td>
                                        <a href="@Url.Action("RepairRequestDetail", "SystemAdmin", new { id = repair.RequestId })" 
                                           class="action-btn btn-view" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("AssignTechnician", "SystemAdmin", new { id = repair.RequestId })" 
                                           class="action-btn btn-assign" title="Assign Technician">
                                            Assign
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/JS/DashboardScript.js"></script>
}
