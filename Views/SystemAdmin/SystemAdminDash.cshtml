

@using SkyTech.Models
@model SkyTech.Models.DeliveryDriver
@{
    ViewBag.Title = "Driver Dashboard";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DriverStyle.css">


}

<div class="d-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="d-sidebar">
        <div class="d-brand">
            <div class="d-brand-icon"><i class="fas fa-truck-fast"></i></div>
            <div>
                <div class="d-brand-name">SkyTech</div>
                <div class="d-brand-sub">Admin Portal</div>
            </div>
        </div>
        <nav class="d-nav">
            <div class="d-nav-label">NAVIGATION</div>
            <a href="@Url.Action("AdminDash", "SystemAdmin")" class="d-link active">
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>

            <div class="d-nav-label">REPAIR MANAGEMENT</div>
            <a href="@Url.Action("PendingRepairRequests", "SystemAdmin")" class="d-link">
                <i class="fas fa-clock"></i><span>Pending Repairs</span>
            </a>
            <a href="@Url.Action("AllRepairRequests", "SystemAdmin")" class="d-link">
                <i class="fas fa-list"></i><span>All Repairs</span>
            </a>
             <div class="d-nav-label">LEASE MANAGEMENT</div>
            <a href="@Url.Action("AllLeaseAgreements", "SystemAdmin")" class="d-link">
                <i class="fas fa-clock"></i><span>All Lease Agreements</span>
            </a>
              <a href="@Url.Action("ReadyForRefund", "SystemAdmin")" class="d-link">
                <i class="fas fa-clock"></i><span>Ready for Refund</span>
            </a>

            <div class="d-nav-label">APPLICATIONS</div>
            <a href="@Url.Action("ViewApplications", "SystemAdmin")" class="d-link">
                <i class="fas fa-building"></i><span>Shop Owners</span>
            </a>

            <a href="@Url.Action("ViewDriverApplication", "SystemAdmin")" class="d-link">
                <i class="fas fa-truck"></i><span>Drivers</span>
            </a>

        </nav>
        <div class="d-sidebar-foot">
            <div class="d-foot-avatar"><i class="fas fa-user-tie"></i></div>
            <div>
                <div class="d-foot-name">Admin Name</div>
                <div class="d-foot-role">Admin</div>
            </div>
        </div>
        <div style="padding:.8rem 1.2rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(239,68,68,.08);
                        border:1.5px solid rgba(239,68,68,.25);border-radius:8px;
                        padding:.6rem 1rem;cursor:pointer;color:#ef4444;
                        font-weight:600;font-size:.85rem;display:flex;
                        align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>

    </aside>

    <!-- ══ MAIN ══ -->
    <main class="d-main">

        <div class="d-topbar">
            <div>
                <div class="d-page-title">Admin  
                Dashboard</div>
                <div class="d-page-sub">Here's a snapshot of your delivery activity.</div>
            </div>
            <div style="display:flex;align-items:center;gap:.6rem">
                <span class="badge" style="background:rgba(22,163,74,.1);color:#15803d;border:1px solid rgba(22,163,74,.25);font-size:.78rem;padding:.35rem .9rem">
                    <i class="fas fa-circle" style="font-size:.5rem;color:var(--green)"></i> Online
                </span>
            </div>

        </div>

    </main>
</div>
