@model IEnumerable<SkyTech.ViewModels.CandidateContractViewModel>

@{
    ViewData["Title"] = "My Contracts";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
     <link rel="stylesheet" href="~/CSS/CUSTOMERCSS/MyContracts.css" />
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">

        <h3>My Employment Contracts</h3>

    </div>

    <div class="card-body">

        @if (Model.Any())
        {
            <table class="table table-bordered table-hover">

                <thead>

                    <tr>

                        <th>Job Title</th>

                        <th>Employment Type</th>

                        <th>Date Sent</th>

                        <th>Status</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.JobTitle</td>

                            <td>@item.EmploymentType</td>

                            <td>@item.DateSent.ToString("dd MMM yyyy")</td>

                            <td>

                                <span class="badge bg-info">

                                    @item.ContractStat

                                </span>

                            </td>

                            <td>

                                @if (item.ContractStat == SkyTech.Models.Interviews.ContractStatus.Sent)
                                {
                                    <a asp-action="SignContract"
                                       asp-route-id="@item.ContractId"
                                       class="btn btn-success">
                                        View Contract
                                    </a>
                                }
                                else if (item.ContractStat == SkyTech.Models.Interviews.ContractStatus.SignedByCandidate)
                                {
                                    <span class="text-success">
                                        Employed
                                    </span>
                                }
                                else if (item.ContractStat == SkyTech.Models.Interviews.ContractStatus.SignedByCompany)
                                {
                                    <span class="text-primary">

                                        Fully Signed

                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="alert alert-info">

                No contracts have been sent to you.

            </div>
        }

    </div>

</div>