@using SkyTech.Models
@model IEnumerable<SkyTech.Models.Order>
@{
    ViewBag.Title = "Home Deliveries";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "HomeDeliveries";
    int driverId = (int)(ViewBag.DriverId ?? 0);
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DriverStyle.css">

    <style>
        .chip-row {
            display: flex;
            flex-wrap: wrap;
            gap: .7rem;
            margin-bottom: 1.5rem
        }

        .chip {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: .6rem 1rem;
            font-size: .8rem;
            font-weight: 700;
            color: var(--text-3);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: .45rem
        }

            .chip .num {
                font-family: var(--font-display);
                font-size: 1.25rem;
                font-weight: 700;
                color: var(--text);
                margin-right: .2rem
            }

            .chip.teal {
                border-color: rgba(95,158,160,.3)
            }

                .chip.teal .num {
                    color: var(--blue)
                }

            .chip.green {
                border-color: rgba(22,163,74,.28)
            }

                .chip.green .num {
                    color: var(--green)
                }

            .chip.yellow {
                border-color: rgba(217,119,6,.28)
            }

                .chip.yellow .num {
                    color: var(--yellow)
                }
    </style>
}

<div class="d-wrap">

    <!-- ══ SIDEBAR ══ -->
    <<aside class="d-sidebar">
        <div class="d-brand">
            <div class="d-brand-icon"><i class="fas fa-truck-fast"></i></div>
            <div>
                <div class="d-brand-name">SkyTech</div>
                <div class="d-brand-sub">Driver Portal</div>
            </div>
        </div>
        <nav class="d-nav">
            <div class="d-nav-label">NAVIGATION</div>
            <a href="@Url.Action("DriverDash", "DeliveryDriver")" class="d-link @(ViewBag.ActivePage == "Dashboard" ? "active" : "")">
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>

            <!-- My Deliveries with dropdown -->
            <div class="nav-item-dropdown">
                <a href="#" class="d-link d-dropdown-toggle @(ViewBag.ActivePage == "HomeDeliveries" || ViewBag.ActivePage == "BranchTransfers" ? "open" : "")" id="deliveriesDropdown">
                    <i class="fas fa-bag-shopping"></i>
                    <span>My Deliveries</span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </a>
                <div class="d-dropdown-menu" id="deliveriesSubmenu" style="display: @(ViewBag.ActivePage == "HomeDeliveries" || ViewBag.ActivePage == "BranchTransfers" ? "block" : "none")">
                    <a href="@Url.Action("HomeDeliveries", "DeliveryDriver")" class="d-link d-sub-link @(ViewBag.ActivePage == "HomeDeliveries" ? "active" : "")">
                        <i class="fas fa-truck"></i> Home Deliveries
                    </a>
                    <a href="@Url.Action("BranchTransfers", "DeliveryDriver")" class="d-link d-sub-link @(ViewBag.ActivePage == "BranchTransfers" ? "active" : "")">
                        <i class="fas fa-arrow-right-arrow-left"></i> Branch Transfers
                    </a>
                </div>
            </div>
            @* <a href="@Url.Action("MyDeliveries", "DeliveryDriver")" class="d-link">
                <i class="fas fa-bag-shopping"></i><span>My Deliveries</span>
            </a> *@
            <a href="@Url.Action("MyTasks", "DeliveryDriver")" class="d-link">
                <i class="fas fa-bag-shopping"></i><span>Returned Order Items</span>
            </a>

            <div class="d-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("DriverProfile", "DeliveryDriver")" class="d-link @(ViewBag.ActivePage == "Profile" ? "active" : "")">
                <i class="fas fa-circle-user"></i><span>Profile</span>
            </a>
        </nav>
        <div class="d-sidebar-foot">
            <div class="d-foot-avatar"><i class="fas fa-user-tie"></i></div>
            <div>
                <div class="d-foot-name">@(ViewBag.DriverName ?? "Delivery Driver")</div>
                <div class="d-foot-role">Delivery Driver</div>
            </div>
        </div>
        <div style="padding:.8rem 1.2rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(239,68,68,.08);
                    border:1.5px solid rgba(239,68,68,.25);border-radius:8px;
                    padding:.6rem 1rem;cursor:pointer;color:#ef4444;
                    font-weight:600;font-size:.85rem;display:flex;
                    align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>

    <!-- ══ MAIN ══ -->
    <main class="d-main">

        <div class="d-topbar">
            <div>
                <div class="d-page-title">Home Deliveries</div>
                <div class="d-page-sub">Orders to deliver to customers.</div>
            </div>
        </div>

        @{
            int total = Model.Count();
            int inProg = Model.Count(o => o.Status == OrderStatus.OutForDelivery || o.Status == OrderStatus.Assigned);
            int done = Model.Count(o => o.Status == OrderStatus.Delivered);
        }

        <div class="chip-row">
            <div class="chip teal"><span class="num">@total</span> Total</div>
            <div class="chip yellow"><span class="num">@inProg</span> In Progress</div>
            <div class="chip green"><span class="num">@done</span> Delivered</div>
        </div>

        <div class="d-card">
            <div class="d-card-head">
                <div class="d-card-title"><i class="fas fa-truck-fast" style="color:var(--blue);margin-right:.4rem"></i>Delivery List</div>
                <div class="d-search">
                    <i class="fas fa-magnifying-glass"></i>
                    <input type="text" placeholder="Search…" oninput="filterRows(this.value)">
                </div>
            </div>
            <div class="d-table-wrap">
                <table class="d-table" id="delivTable">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Delivery Address</th>
                            <th>Status</th>
                            <th>Ordered On</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            string sc = order.Status == OrderStatus.Pending ? "badge-pending"
                            : order.Status == OrderStatus.Assigned ? "badge-assigned"
                            : order.Status == OrderStatus.OutForDelivery ? "badge-out"
                            : "badge-delivered";
                            <tr data-search="@($"{order.OrderId} {order.DeliveryAddress} {order.Status}".ToLower())">
                                <td>
                                    <span style="font-family:var(--font-display);font-weight:700;color:var(--blue)">#@order.OrderId</span>
                                </td>
                                <td style="max-width:200px;font-size:.85rem;color:var(--text-3)">@order.DeliveryAddress</td>
                                <td><span class="badge @sc">@order.Status</span></td>
                                <td style="font-size:.8rem;color:var(--text-muted)">@order.OrderedOn.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a href="@Url.Action("DriverDeliveryView", "DeliveryDriver", new { id = order.OrderId })"
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-map-location-dot"></i> Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:4rem 2rem;color:var(--text-muted)">
                        <i class="fas fa-truck" style="font-size:3rem;opacity:.18;display:block;margin-bottom:.9rem"></i>
                        <p style="font-weight:600">No home deliveries assigned yet.</p>
                    </div>
                }
            </div>
        </div>

    </main>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dropdownToggle = document.getElementById('deliveriesDropdown');
            const dropdownMenu = document.querySelector('.d-dropdown-menu');

            if (dropdownToggle && dropdownMenu) {
                dropdownToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    this.classList.toggle('open');
                    if (dropdownMenu.style.display === 'none') {
                        dropdownMenu.style.display = 'block';
                    } else {
                        dropdownMenu.style.display = 'none';
                    }
                });
            }
        });
    </script>
</div>

<script>
    function filterRows(q) {
        var rows = document.querySelectorAll('#delivTable tbody tr');
        var t = q.toLowerCase();
        rows.forEach(function (r) { r.style.display = (r.dataset.search || '').includes(t) ? '' : 'none' });
    }
</script>