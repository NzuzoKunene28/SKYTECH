
@model SkyTech.Models.Repair_Item_Services.Repair_Request

@{
    ViewData["Title"] = "Request Repair Service";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";   // ← add this
    ViewBag.ActivePage = "NewRepair";                   // ← for sidebar active state
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DashboardStyle.css">
}


<div class="dash-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="dash-sidebar">
        <!-- copy the entire <aside> block from your dashboard view exactly -->
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="dash-main">

        <div class="dash-topbar">
            <div>
                <div class="dash-page-title">Request Repair Service</div>
                <div class="dash-page-sub">Submit your repair request below and we'll assign a technician.</div>
            </div>
        </div>

        <div class="dash-card" style="max-width:720px">
            <div class="dash-card-head">
                <div class="dash-card-title">
                    <i class="fas fa-tools" style="color:var(--orange);margin-right:0.5rem"></i>
                    New Repair Request
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="dash-alert dash-alert-warning"></div>

                <div style="display:flex;flex-direction:column;gap:1.2rem">

                    <div>
                        <label asp-for="CategoryId" style="font-size:0.9rem;color:var(--text-muted);font-weight:600;margin-bottom:0.4rem;display:block">
                            <i class="fas fa-tag" style="color:var(--blue);margin-right:0.4rem"></i>Item Category
                        </label>
                        <select asp-for="CategoryId" class="form-control form-select" asp-items="ViewBag.CategoryId" required
                                style="background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;color:var(--text);width:100%">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger" style="font-size:0.8rem"></span>
                    </div>

                    <div>
                        <label asp-for="ItemName" style="font-size:0.9rem;color:var(--text-muted);font-weight:600;margin-bottom:0.4rem;display:block">
                            <i class="fas fa-box" style="color:var(--blue);margin-right:0.4rem"></i>Item Name
                        </label>
                        <input asp-for="ItemName" class="form-control" placeholder="e.g., Samsung TV, Kitchen Blender" required
                               style="background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;color:var(--text);width:100%" />
                        <span asp-validation-for="ItemName" class="text-danger" style="font-size:0.8rem"></span>
                    </div>

                    <div>
                        <label asp-for="ItemDescription" style="font-size:0.9rem;color:var(--text-muted);font-weight:600;margin-bottom:0.4rem;display:block">
                            <i class="fas fa-align-left" style="color:var(--blue);margin-right:0.4rem"></i>Item Description
                        </label>
                        <textarea asp-for="ItemDescription" rows="3" placeholder="Describe the item (color, model, age, etc.)" required
                                  style="background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;color:var(--text);width:100%;resize:vertical"></textarea>
                        <span asp-validation-for="ItemDescription" class="text-danger" style="font-size:0.8rem"></span>
                    </div>

                    <div>
                        <label asp-for="IssueDescription" style="font-size:0.9rem;color:var(--text-muted);font-weight:600;margin-bottom:0.4rem;display:block">
                            <i class="fas fa-exclamation-circle" style="color:var(--orange);margin-right:0.4rem"></i>What's the Problem?
                        </label>
                        <textarea asp-for="IssueDescription" rows="4" placeholder="Describe the issue in detail. This helps us assign the right technician." required
                                  style="background:var(--surface2);border:1.5px solid var(--border);border-radius:8px;padding:0.6rem 0.9rem;color:var(--text);width:100%;resize:vertical"></textarea>
                        <span asp-validation-for="IssueDescription" class="text-danger" style="font-size:0.8rem"></span>
                    </div>


                </div>

                <div style="margin-top:1.8rem;padding-top:1.4rem;border-top:1px solid var(--border);display:flex;gap:0.8rem;justify-content:flex-end">
                    <a asp-action="CustomerRepairRequests" asp-controller="Customer" class="dash-btn dash-btn-secondary">
                        <i class="fas fa-arrow-left"></i> Cancel
                    </a>
                    <button type="submit" class="dash-btn dash-btn-primary">
                        <i class="fas fa-paper-plane"></i> Submit Request
                    </button>
                </div>
            </form>
        </div>

    </main>
</div>
