@model SkyTech.Models.ViewModels.EligibilityResultViewModel

@{
    ViewData["Title"] = "Eligibility Result";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";

    var isEligible =
        Model.EligibilityResult ==
        SkyTech.Models.SkytechWorkers.EligibilityResult.Eligible;
}

<style>
    :root {
        --blue: #5f9ea0;
        --blue-dark: #2d6b6d;
        --blue-deep: #1f4f50;
        --bg: #f0f4fc;
        --border: #dde6f5;
        --text: #0e1b35;
        --text-2: #4a5878;
        --text-m: #8a96b0;
        --red: #dc2626;
    }

    .eligibility-page {
        min-height: 80vh;
        background: var(--bg);
        padding: 45px 20px;
    }

    .eligibility-container {
        max-width: 1000px;
        margin: auto;
    }

    .page-label {
        color: var(--blue-dark);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .page-title {
        color: var(--text);
        font-size: 34px;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: var(--text-2);
        margin-bottom: 30px;
    }

    .result-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 35px;
        margin-bottom: 25px;
        box-shadow: 0 12px 35px rgba(31, 79, 80, 0.07);
    }

    .result-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .result-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .eligible-icon {
        background: #e2f4ec;
        color: #198754;
    }

    .not-eligible-icon {
        background: #fde8e8;
        color: var(--red);
    }

    .result-title {
        margin: 0;
        color: var(--text);
        font-size: 25px;
        font-weight: 700;
    }

    .result-description {
        color: var(--text-2);
        margin: 5px 0 0;
    }

    .information-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 25px;
    }

    .information-box {
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 20px;
        background: #fbfcff;
    }

    .information-label {
        color: var(--text-m);
        font-size: 13px;
        margin-bottom: 8px;
    }

    .information-value {
        color: var(--text);
        font-size: 21px;
        font-weight: 700;
    }

    .clear {
        color: #198754;
    }

    .unclear {
        color: var(--red);
    }

    .continue-btn {
        display: inline-block;
        background: var(--blue-dark);
        color: white;
        border: none;
        padding: 13px 24px;
        border-radius: 11px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .continue-btn:hover {
        background: var(--blue-deep);
        color: white;
        transform: translateY(-1px);
    }

    .back-btn {
        display: inline-block;
        background: white;
        color: var(--text-2);
        border: 1px solid var(--border);
        padding: 13px 24px;
        border-radius: 11px;
        font-weight: 600;
        text-decoration: none;
    }

    /* @@media (max-width: 700px) {
        .information-grid {
            grid-template-columns: 1fr;
        }

        .result-card {
            padding: 25px;
        } */
    }
</style>

<div class="eligibility-page">

    <div class="eligibility-container">

        <div class="page-label">
            Step 2 of 4
        </div>

        <h1 class="page-title">
            Eligibility Result
        </h1>

        <p class="page-subtitle">
            Your automated credit and clearance assessment is complete.
        </p>

        <div class="result-card">

            <div class="result-header">

                <div class="result-icon @(isEligible ? "eligible-icon" : "not-eligible-icon")">
                    @(isEligible ? "✓" : "!")
                </div>

                <div>
                    @if (isEligible)
                    {
                        <h2 class="result-title">
                            You're pre-approved to continue
                        </h2>

                        <p class="result-description">
                            Your application passed the automated eligibility checks.
                        </p>
                    }
                    else
                    {
                        <h2 class="result-title">
                            Not eligible for automatic approval
                        </h2>

                        <p class="result-description">
                            Your application does not currently meet the criteria
                            for automatic approval.
                        </p>
                    }
                </div>

            </div>

            <div class="information-grid">

                <div class="information-box">
                    <div class="information-label">
                        Credit Score
                    </div>

                    <div class="information-value">
                        @Model.CreditScore
                    </div>
                </div>

                <div class="information-box">
                    <div class="information-label">
                        Clearance Status
                    </div>

                    <div class="information-value @(Model.ClearanceStatus == SkyTech.Models.SkytechWorkers.ClearanceStatus.Clear ? "clear" : "unclear")">
                        @Model.ClearanceStatus
                    </div>
                </div>

                <div class="information-box">
                    <div class="information-label">
                        Requested Amount
                    </div>

                    <div class="information-value">
                        @Model.RequestedAmount.ToString("R0.00")
                    </div>
                </div>

            </div>

        </div>

        <div>
            @if (isEligible)
            {
                <a asp-action="UploadCollateral"
                   asp-route-id="@Model.LoanApplicationId"
                   class="continue-btn">
                    Continue to Collateral →
                </a>
            }
            else
            {
                <a asp-action="Apply"
                   class="back-btn">
                    Back to Application
                </a>
            }
        </div>

    </div>

</div>