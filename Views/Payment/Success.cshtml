@{
    ViewBag.Title = "Payment Successful";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";

    string reference = ViewBag.Reference?.ToString() ?? "—";
    string email = ViewBag.Email?.ToString() ?? "—";
    decimal amount = (decimal?)ViewBag.Amount ?? 0m;
    string orderId = ViewBag.OrderId?.ToString() ?? "—";
    string address = ViewBag.DeliveryAddr?.ToString() ?? "—";
    string items = ViewBag.ItemCount?.ToString() ?? "—";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/PaymentStyle.css">
  
}

<div class="pay-bg">
    <div class="conf" id="conf"></div>

    <div class="receipt">

        <!-- Green success header -->
        <div class="r-head">
            <div class="check-ring"><i class="fas fa-check"></i></div>
            <h2>Payment Successful!</h2>
            <p>Your order is confirmed and being prepared.</p>
        </div>

        <!-- Receipt rows -->
        <div class="r-body">

            <div class="r-row">
                <span class="k"><i class="fas fa-hashtag" style="color:#1a73e8"></i>Order ID</span>
                <span class="v" style="color:#1a73e8">#@orderId</span>
            </div>

            <div class="r-row">
                <span class="k"><i class="fas fa-envelope" style="color:#1a73e8"></i>Email</span>
                <span class="v" style="font-size:.8rem">@email</span>
            </div>

            @if (items != "—")
            {
                <div class="r-row">
                    <span class="k"><i class="fas fa-box" style="color:#1a73e8"></i>Items</span>
                    <span class="v">@items item@(items != "1" ? "s" : "")</span>
                </div>
            }

            @if (address != "—")
            {
                <div class="r-row">
                    <span class="k"><i class="fas fa-location-dot" style="color:#1a73e8"></i>Deliver To</span>
                    <span class="v" style="max-width:220px;font-size:.83rem">@address</span>
                </div>
            }

            <hr class="r-divider" />

            <div class="r-row">
                <span class="k"><i class="fas fa-money-bill-wave" style="color:#16a34a"></i>Amount Paid</span>
                <span class="v amount">R @amount.ToString("N2")</span>
            </div>

            <div class="r-row">
                <span class="k"><i class="fas fa-receipt" style="color:#1a73e8"></i>Reference</span>
                <span class="v"><span class="ref-pill">@reference</span></span>
            </div>

            <div class="r-row">
                <span class="k"><i class="fas fa-clock" style="color:#1a73e8"></i>Paid At</span>
                <span class="v" style="font-size:.8rem">@DateTime.Now.ToString("dd MMM yyyy · HH:mm")</span>
            </div>

        </div>

        <!-- Buttons -->
        <div class="r-foot">
            <a href="@Url.Action("ShoppingPage","Customer")" class="btn-g">
                <i class="fas fa-bag-shopping"></i> Continue Shopping
            </a>
            <a href="@Url.Action("OrderHistory","Customer")" class="btn-o">
                <i class="fas fa-clock-rotate-left"></i> View Order History
            </a>
        </div>

    </div>
</div>

<script>(function() {
    var w = document.getElementById('conf');
    var c = ['#1a73e8','#16a34a','#d97706','#ea580c','#7c3aed','#db2777','#0891b2','#f59e0b'];
    for (var i = 0; i < 40; i++) {
        var d = document.createElement('div');
        var s = 6 + Math.random() * 10;
        d.className = 'dot';
        d.style.cssText = [
            'width:' + s + 'px', 'height:' + s + 'px',
            'left:' + Math.random() * 100 + '%',
            'background:' + c[Math.floor(Math.random() * c.length)],
            'animation-delay:' + (Math.random() * 1.5) + 's',
            'animation-duration:' + (2.2 + Math.random() * 1.2) + 's'
        ].join(';');
        w.appendChild(d);
    }
})();</script>
