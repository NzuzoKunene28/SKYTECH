@model SkyTech.Models.ViewModels.RepayLoanViewModel

<link rel="stylesheet" href="~/CSS/Disburse.css" />

<div class="settle-wrap">

    <div class="settle-card">
        <div class="settle-chart-head">
            <div class="circle-ring cr-1"></div>
            <div class="circle-ring cr-2"></div>
            <h5>Balance over time</h5>
            <p>Track how your outstanding balance has dropped with each payment.</p>
        </div>
        <div class="settle-chart-body">
            <canvas id="balanceChart" height="110"></canvas>
        </div>
    </div>

    <div class="settle-card">
        <div class="settle-body">
            <h3>Settle loan</h3>
            <p class="settle-subtext">Confirm your details below and choose how much you'd like to pay.</p>

            <div class="settle-stats">
                <div class="stat-chip">
                    <div class="stat-label">Outstanding Balance</div>
                    <div class="stat-value">R@(Model.OutstandingBalance.ToString("N2"))</div>
                </div>

                <div class="stat-chip">
                    <div class="stat-label">Due Date</div>
                    <div class="stat-value">@Model.DueDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="collateral-section">
                <div class="stat-label" style="margin-bottom: .6rem;">Your Collateral</div>
                <div class="collateral-grid">
                    @foreach (var item in Model.Collateral)
                    {
                        <div class="collateral-card" data-src="@item.ImagePath" data-caption="@item.Description" onclick="openCollateralLightbox(this.dataset.src, this.dataset.caption)">
                            <img src="@item.ImagePath" alt="@item.Description" class="collateral-img" />
                            <div class="collateral-info">
                                <div class="collateral-name">@item.Description</div>
                                <div class="collateral-meta">R@(item.DeclaredValue.ToString("N2")) · @item.Condition</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Lightbox overlay -->
                <div id="collateralLightbox" class="lightbox-overlay" onclick="closeCollateralLightbox()">
                    <div class="lightbox-content" onclick="event.stopPropagation()">
                        <img id="lightboxImg" src="" alt="" />
                        <div id="lightboxCaption" class="lightbox-caption"></div>
                        <button type="button" class="lightbox-close" onclick="closeCollateralLightbox()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="val-summary">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="SettleLoan" method="post" id="settleForm">
                <input type="hidden" asp-for="LoanId" />

                <div class="f-group">
                    <label asp-for="PaymentAmount" class="f-label"><i class="fa-solid fa-coins"></i> Payment Amount</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-money-bill-wave"></i>
                        <input asp-for="PaymentAmount" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="PaymentAmount" class="text-danger"></span>
                </div>

                <div class="f-group">
                    <label asp-for="TransferReferenceInput" class="f-label"><i class="fa-solid fa-shield-halved"></i> Transfer Reference</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-hashtag"></i>
                        <input asp-for="TransferReferenceInput" placeholder="e.g. SIM-5DF1BBA6" />
                    </div>
                    <span asp-validation-for="TransferReferenceInput" class="text-danger"></span>
                    <div class="f-hint">Found on your loan disbursement confirmation.</div>
                </div>

                <div class="f-group">
                    <label asp-for="PaymentMethod" class="f-label"><i class="fa-solid fa-credit-card"></i> Payment Method</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-wallet"></i>
                        <select asp-for="PaymentMethod">
                            @foreach (var method in Enum.GetValues<SkyTech.Models.SkytechWorkers.PaymentMethod>())
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <span class="chevron"><i class="fa-solid fa-chevron-down"></i></span>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="settleButton">
                    <i class="fa-solid fa-check"></i> Settle Payment
                </button>
            </form>
        </div>
    </div>

</div>

<!-- ============ PAYMENT PROCESSING OVERLAY ============ -->
<div class="pay-overlay" id="paymentLoading" aria-live="polite">
    <div class="pay-card">

        <div class="pay-ring">
            <div class="pay-ring-spin"></div>
            <svg class="pay-lock" viewBox="0 0 24 24" width="26" height="26" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="11" width="16" height="9" rx="2"></rect>
                <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
            </svg>
        </div>

        <div class="pay-title">Processing Payment</div>
        <div class="pay-amount" id="payAmountText"></div>

        <div class="pay-bar"><div class="pay-bar-fill" id="payBarFill"></div></div>

        <ul class="pay-steps" id="paySteps">
            <li>Verifying transfer reference</li>
            <li>Checking payment amount</li>
            <li>Processing your payment</li>
            <li>Updating your balance</li>
        </ul>

        <div class="pay-warning">Please do not close or refresh this page.</div>
    </div>
</div>

<script>
    function openCollateralLightbox(src, caption) {
        document.getElementById('lightboxImg').src = src;
        document.getElementById('lightboxCaption').textContent = caption;
        document.getElementById('collateralLightbox').classList.add('active');
    }

    function closeCollateralLightbox() {
        document.getElementById('collateralLightbox').classList.remove('active');
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(Json.Serialize(Model.BalanceHistory.Select(p => p.Date.ToString("dd MMM"))));
    const balances = @Html.Raw(Json.Serialize(Model.BalanceHistory.Select(p => p.Balance)));

    new Chart(document.getElementById('balanceChart'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Outstanding balance (R)',
                data: balances,
                borderColor: '#2d6b6d',
                backgroundColor: 'rgba(95,158,160,0.12)',
                fill: true,
                stepped: 'before',
                tension: 0,
                pointBackgroundColor: '#1f4f50',
                pointRadius: 4
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { grid: { color: '#eef2fa' } }
            }
        }
    });
</script>

<!-- ============ PAYMENT LOADING SCRIPT (no jQuery dependency) ============ -->
<script>
    (function () {
        var TOTAL_MS = 5000;   // animation length; keep in sync with "transition: width 5s" in RepayLoan.css

        var form = document.getElementById("settleForm");
        var button = document.getElementById("settleButton");
        var overlay = document.getElementById("paymentLoading");
        var barFill = document.getElementById("payBarFill");
        var amountText = document.getElementById("payAmountText");
        var amountInput = document.getElementById("PaymentAmount");
        var steps = document.querySelectorAll("#paySteps li");
        var buttonHtml = button.innerHTML;
        var submitting = false;

        function isValid() {
            if (window.jQuery && jQuery.fn && jQuery.fn.valid) return jQuery(form).valid();
            return form.checkValidity();
        }

        function formatAmount(v) {
            var s = String(v || "").replace(/\s/g, "");
            if (s.indexOf(",") > -1 && s.indexOf(".") === -1) s = s.replace(",", ".");
            else s = s.replace(/,/g, "");
            var n = parseFloat(s);
            if (isNaN(n)) return "";
            return "R" + n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        form.addEventListener("submit", function (e) {
            if (submitting) { e.preventDefault(); return; }
            if (!isValid()) return;            // let validation messages show

            e.preventDefault();
            submitting = true;

            amountText.textContent = formatAmount(amountInput.value);
            button.disabled = true;
            button.textContent = "Processing...";
            overlay.classList.add("active");

            // start the progress bar (next frames so the transition runs)
            requestAnimationFrame(function () {
                requestAnimationFrame(function () { barFill.classList.add("run"); });
            });

            // tick through the steps
            var stepTime = TOTAL_MS / steps.length;
            steps.forEach(function (li, i) {
                setTimeout(function () {
                    if (i > 0) { steps[i - 1].classList.remove("current"); steps[i - 1].classList.add("done"); }
                    li.classList.add("current");
                }, i * stepTime);
            });
            setTimeout(function () {
                var last = steps[steps.length - 1];
                last.classList.remove("current");
                last.classList.add("done");
            }, TOTAL_MS - 300);

            // submit for real once the animation finishes
            setTimeout(function () { form.submit(); }, TOTAL_MS);
        });

        // reset if the user returns with the Back button
        window.addEventListener("pageshow", function (ev) {
            if (ev.persisted) {
                submitting = false;
                overlay.classList.remove("active");
                barFill.classList.remove("run");
                button.disabled = false;
                button.innerHTML = buttonHtml;
                steps.forEach(function (li) { li.classList.remove("current", "done"); });
            }
        });
    })();
</script>
