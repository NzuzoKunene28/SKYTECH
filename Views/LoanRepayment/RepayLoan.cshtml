@model SkyTech.Models.ViewModels.RepayLoanViewModel

<style>
    :root {
        --blue: #5f9ea0;
        --blue-dark: #2d6b6d;
        --blue-deep: #1f4f50;
        --bg: #f0f4fc;
        --border: #dde6f5;
        --text: #0e1b35;
        --text-2: #4a5878;
        --text-m: #8a96b0;
        --red: #dc2626;
        --green: #16a34a;
    }

    .settle-wrap {
        font-family: 'Plus Jakarta Sans', sans-serif;
        max-width: 720px;
        margin: 2rem auto;
        padding: 0 1rem;
        position: relative;
    }

    .settle-card {
        background: #fff;
        border-radius: 28px;
        border: 1.5px solid var(--border);
        box-shadow: 0 24px 80px rgba(31,79,80,.12);
        overflow: hidden;
        margin-bottom: 1.5rem;
        animation: settleFadeUp .45s ease;
    }

    @@keyframes settleFadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Chart card header (mirrors login-panel treatment) ── */
    .settle-chart-head {
        background-color: cadetblue;
        padding: 1.75rem 2rem 1.25rem;
        position: relative;
        overflow: hidden;
    }

        .settle-chart-head::before {
            content: '';
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image: linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
            background-size: 30px 30px;
        }

        .settle-chart-head h5 {
            position: relative;
            z-index: 1;
            font-family: 'Clash Display', 'Plus Jakarta Sans', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: #fff;
            letter-spacing: -.2px;
            margin: 0;
        }

        .settle-chart-head p {
            position: relative;
            z-index: 1;
            font-size: .78rem;
            color: rgba(255,255,255,.7);
            margin-top: .25rem;
        }

    .circle-ring {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.12);
        pointer-events: none;
    }

    .cr-1 { width: 180px; height: 180px; bottom: -50px; right: -40px; }
    .cr-2 { width: 120px; height: 120px; bottom: -20px; right: -10px; }

    .settle-chart-body {
        padding: 1.5rem 2rem 1.75rem;
    }

    /* ── Detail card body ── */
    .settle-body {
        padding: 2.25rem 2.5rem;
    }

    .settle-body h3 {
        font-family: 'Clash Display', 'Plus Jakarta Sans', sans-serif;
        font-size: 1.55rem;
        font-weight: 700;
        color: var(--text);
        letter-spacing: -.4px;
        margin-bottom: .3rem;
    }

    .settle-subtext {
        font-size: .85rem;
        color: var(--text-m);
        margin-bottom: 1.5rem;
    }

    .settle-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .9rem;
        margin-bottom: 1.75rem;
    }

    .stat-chip {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: .9rem 1.1rem;
    }

        .stat-chip .stat-label {
            font-size: .72rem;
            font-weight: 700;
            color: var(--text-m);
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: .3rem;
        }

        .stat-chip .stat-value {
            font-family: 'Clash Display', 'Plus Jakarta Sans', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--blue-deep);
        }

        .stat-chip.collateral .stat-value {
            font-size: .95rem;
            color: var(--text);
        }

    .f-group {
        margin-bottom: 1.1rem;
    }

    .f-label {
        font-size: .78rem;
        font-weight: 700;
        color: var(--text-2);
        display: flex;
        align-items: center;
        gap: .35rem;
        margin-bottom: .42rem;
    }

    .f-wrap {
        position: relative;
    }

        .f-wrap i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-m);
            font-size: .85rem;
            pointer-events: none;
        }

        .f-wrap input,
        .f-wrap select {
            width: 100%;
            padding: .82rem 1rem .82rem 2.6rem;
            background: var(--bg);
            border: 1.5px solid var(--border);
            border-radius: 50px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: .9rem;
            color: var(--text);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
            appearance: none;
        }

            .f-wrap input:focus,
            .f-wrap select:focus {
                border-color: var(--blue);
                background: #fff;
                box-shadow: 0 0 0 3px rgba(95,158,160,.1);
            }

        .f-wrap .chevron {
            position: absolute;
            right: 1.1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-m);
            font-size: .75rem;
            pointer-events: none;
        }

    .f-hint {
        font-size: .74rem;
        color: var(--text-m);
        margin-top: .35rem;
        padding-left: .5rem;
    }

    .text-danger {
        font-size: .75rem;
        color: var(--red);
        margin-top: .3rem;
        font-weight: 600;
        display: block;
        padding-left: .5rem;
    }

    .val-summary {
        background: rgba(220,38,38,.07);
        border: 1.5px solid rgba(220,38,38,.22);
        border-radius: 12px;
        padding: .8rem 1.1rem;
        margin-bottom: 1.2rem;
    }

        .val-summary ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .val-summary li {
            font-size: .8rem;
            color: var(--red);
            font-weight: 600;
        }

    .btn-login {
        width: 100%;
        padding: .9rem;
        border: none;
        border-radius: 50px;
        background: linear-gradient(135deg, #5f9ea0, #2d6b6d);
        color: #fff;
        font-family: 'Clash Display', 'Plus Jakarta Sans', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 18px rgba(95,158,160,.3);
        transition: all .2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        margin-top: .5rem;
    }

        .btn-login:hover {
            box-shadow: 0 6px 24px rgba(95,158,160,.42);
            transform: translateY(-1px);
        }

    /* ── Confirmation-style states (used if OutstandingBalance <= 0 view reuses this file) ── */
    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(22,163,74,.1);
        color: var(--green);
        font-size: 1.4rem;
        margin-bottom: 1rem;
    }

    .collateral-section {
        margin-bottom: 1.75rem;
    }

    .collateral-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: .9rem;
    }

    .collateral-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
    }

    .collateral-img {
        width: 100%;
        height: 110px;
        object-fit: cover;
        display: block;
        background: #e4eeee;
    }

    .collateral-info {
        padding: .6rem .75rem .75rem;
    }

    .collateral-name {
        font-size: .82rem;
        font-weight: 700;
        color: var(--text);
        margin-bottom: .15rem;
    }

    .collateral-meta {
        font-size: .72rem;
        color: var(--text-m);
    }

    .collateral-card {
        cursor: pointer;
        transition: transform .15s ease;
    }

        .collateral-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(31,79,80,.1);
        }

    .lightbox-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(14,27,53,.82);
        z-index: 999;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

        .lightbox-overlay.active {
            display: flex;
        }

    .lightbox-content {
        position: relative;
        max-width: 90vw;
        max-height: 85vh;
    }

        .lightbox-content img {
            max-width: 100%;
            max-height: 80vh;
            border-radius: 14px;
            display: block;
        }

    .lightbox-caption {
        color: #fff;
        text-align: center;
        font-size: .85rem;
        margin-top: .75rem;
        font-weight: 600;
    }

    .lightbox-close {
        position: absolute;
        top: -14px;
        right: -14px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #fff;
        border: none;
        color: var(--text);
        font-size: .9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(0,0,0,.2);
    }

</style>

<div class="settle-wrap">

    <div class="settle-card">
        <div class="settle-chart-head">
            <div class="circle-ring cr-1"></div>
            <div class="circle-ring cr-2"></div>
            <h5>Balance over time</h5>
            <p>Track how your outstanding balance has dropped with each payment.</p>
        </div>
        <div class="settle-chart-body">
            <canvas id="balanceChart" height="110"></canvas>
        </div>
    </div>

    <div class="settle-card">
        <div class="settle-body">
            <h3>Settle loan</h3>
            <p class="settle-subtext">Confirm your details below and choose how much you'd like to pay.</p>

            <div class="settle-stats">
                <div class="stat-chip">
                    <div class="stat-label">Outstanding Balance</div>
                    <div class="stat-value">R@(Model.OutstandingBalance.ToString("N2"))</div>
                </div>

                <div class="stat-chip">
                    <div class="stat-label">Due Date</div>
                    <div class="stat-value">@Model.DueDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>

            <div class="collateral-section">
                <div class="stat-label" style="margin-bottom: .6rem;">Your Collateral</div>
                <div class="collateral-grid">
                    @foreach (var item in Model.Collateral)
                    {
                        <div class="collateral-card" onclick="openCollateralLightbox('@item.ImagePath', '@item.Description')">
                            <img src="@item.ImagePath" alt="@item.Description" class="collateral-img" />
                            <div class="collateral-info">
                                <div class="collateral-name">@item.Description</div>
                                <div class="collateral-meta">R@(item.DeclaredValue.ToString("N2")) · @item.Condition</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Lightbox overlay -->
                <div id="collateralLightbox" class="lightbox-overlay" onclick="closeCollateralLightbox()">
                    <div class="lightbox-content" onclick="event.stopPropagation()">
                        <img id="lightboxImg" src="" alt="" />
                        <div id="lightboxCaption" class="lightbox-caption"></div>
                        <button class="lightbox-close" onclick="closeCollateralLightbox()">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="val-summary">
                    <ul>
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="SettleLoan" method="post">
                <input type="hidden" asp-for="LoanId" />

                <div class="f-group">
                    <label asp-for="PaymentAmount" class="f-label"><i class="fa-solid fa-coins"></i> Payment Amount</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-money-bill-wave"></i>
                        <input asp-for="PaymentAmount" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="PaymentAmount" class="text-danger"></span>
                </div>

                <div class="f-group">
                    <label asp-for="TransferReferenceInput" class="f-label"><i class="fa-solid fa-shield-halved"></i> Transfer Reference</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-hashtag"></i>
                        <input asp-for="TransferReferenceInput" placeholder="e.g. SIM-5DF1BBA6" />
                    </div>
                    <span asp-validation-for="TransferReferenceInput" class="text-danger"></span>
                    <div class="f-hint">Found on your loan disbursement confirmation.</div>
                </div>

                <div class="f-group">
                    <label asp-for="PaymentMethod" class="f-label"><i class="fa-solid fa-credit-card"></i> Payment Method</label>
                    <div class="f-wrap">
                        <i class="fa-solid fa-wallet"></i>
                        <select asp-for="PaymentMethod">
                            @foreach (var method in Enum.GetValues<SkyTech.Models.SkytechWorkers.PaymentMethod>())
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                        <span class="chevron"><i class="fa-solid fa-chevron-down"></i></span>
                    </div>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fa-solid fa-check"></i> Settle Payment
                </button>
            </form>
        </div>
    </div>

</div>

<script>
    function openCollateralLightbox(src, caption) {
        document.getElementById('lightboxImg').src = src;
        document.getElementById('lightboxCaption').textContent = caption;
        document.getElementById('collateralLightbox').classList.add('active');
    }

    function closeCollateralLightbox() {
        document.getElementById('collateralLightbox').classList.remove('active');
    }
</script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(Json.Serialize(Model.BalanceHistory.Select(p => p.Date.ToString("dd MMM"))));
    const balances = @Html.Raw(Json.Serialize(Model.BalanceHistory.Select(p => p.Balance)));

    new Chart(document.getElementById('balanceChart'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Outstanding balance (R)',
                data: balances,
                borderColor: '#2d6b6d',
                backgroundColor: 'rgba(95,158,160,0.12)',
                fill: true,
                stepped: 'before',
                tension: 0,
                pointBackgroundColor: '#1f4f50',
                pointRadius: 4
            }]
        },
        options: {
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false } },
                y: { grid: { color: '#eef2fa' } }
            }
        }
    });
</script>
