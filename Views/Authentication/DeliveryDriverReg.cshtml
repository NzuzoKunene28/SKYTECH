@model SkyTech.ViewModels.DeliveryDriverViewModel
@{
    ViewBag.Title = "Delivery Driver Registration";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <link rel="stylesheet" href="~/CSS/RegistrationForms.css">
}

@section Scripts {
    <script src="~/MyScripts/PasswordProgressBar.js"></script>
}
<main class="so-main">

    @if (TempData["Message"] != null)
    {
        <div class="so-alert so-alert-success">
            <i class="fas fa-circle-check"></i> @TempData["Message"]
        </div>
    }

    @using (Html.BeginForm("DeliveryDriverReg", "Authentication", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "so-alert so-alert-error" })

        <!-- Personal Details -->
        <div class="so-card" style="margin-bottom:1.2rem">
            <div class="so-card-head">
                <div class="so-card-title">
                    <i class="fas fa-user" style="color:var(--blue);margin-right:.4rem"></i>Personal Details
                </div>
            </div>
            <div class="so-card-body">
                <div class="so-form-grid">

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-pen"></i> First Name</label>
                        @Html.TextBoxFor(m => m.DriverName, new { @class = "so-input", placeholder = "e.g. Thabo", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.DriverName, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-pen"></i> Last Name</label>
                        @Html.TextBoxFor(m => m.DriverSurname, new { @class = "so-input", placeholder = "e.g. Mokoena", maxlength = "100" })
                        @Html.ValidationMessageFor(m => m.DriverSurname, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-envelope"></i> Email Address</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "so-input", placeholder = "driver@example.com", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-home"></i> Residential Address</label>
                        @Html.TextBoxFor(m => m.ResidentialAddress, new { @class = "so-input", placeholder = "Street Name, City" })
                        @Html.ValidationMessageFor(m => m.ResidentialAddress, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-phone"></i> Phone Number</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "so-input", placeholder = "0812345678", maxlength = "10", type = "tel" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-id-card"></i> Licence Number</label>
                        @Html.TextBoxFor(m => m.LicenceNumber, new { @class = "so-input", placeholder = "e.g. GP123456" })
                        @Html.ValidationMessageFor(m => m.LicenceNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-car"></i> Vehicle Type</label>
                        @Html.TextBoxFor(m => m.VehicleType, new { @class = "so-input", placeholder = "e.g. Sedan, Bakkie, Motorcycle" })
                        @Html.ValidationMessageFor(m => m.VehicleType, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-car-side"></i> Vehicle Number Plate</label>
                        @Html.TextBoxFor(m => m.VehicleNumber, new { @class = "so-input", placeholder = "e.g. GP 123 456" })
                        @Html.ValidationMessageFor(m => m.VehicleNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-university"></i> Account Number</label>
                        @Html.TextBoxFor(m => m.AccountNumber, new { @class = "so-input", placeholder = "Your bank account number" })
                        @Html.ValidationMessageFor(m => m.AccountNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-building-columns"></i> Bank Name</label>
                        @Html.TextBoxFor(m => m.BankType, new { @class = "so-input", placeholder = "e.g. FNB, Capitec, ABSA" })
                        @Html.ValidationMessageFor(m => m.BankType, "", new { @class = "text-danger" })
                    </div>

                    <!-- File: Identity Book -->
                    <div class="so-form-group file-input-group">
                        <label class="so-label"><i class="fas fa-id-card"></i> Certified Identity Book</label>
                        <input type="file" name="DriverIdentityBook" class="so-input" accept=".pdf,.jpg,.png,.jpeg" />
                        <small style="color:var(--text-muted)">PDF, JPG, PNG (max 5MB)</small>
                    </div>

                    <!-- File: Driver's Licence -->
                    <div class="so-form-group file-input-group">
                        <label class="so-label"><i class="fas fa-certificate"></i> Driver's Licence</label>
                        <input type="file" name="DriversLicence" class="so-input" accept=".pdf,.jpg,.png,.jpeg" />
                        <small style="color:var(--text-muted)">PDF, JPG, PNG (max 5MB)</small>
                    </div>

                </div>
            </div>
        </div>

        <!-- Account Credentials -->
        <div class="so-card">
            <div class="so-card-head">
                <div class="so-card-title">
                    <i class="fas fa-lock" style="color:var(--blue);margin-right:.4rem"></i>Account Credentials
                </div>
            </div>
            <div class="so-card-body">
                <div class="so-form-grid">

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-key"></i> Password</label>
                        <div class="pw-wrap">
                            @Html.PasswordFor(m => m.Password, new { @class = "so-input", id = "pwField", placeholder = "Min. 8 characters", autocomplete = "new-password" })
                            <i class="fas fa-eye pw-eye" onclick="togglePw('pwField', this)"></i>
                        </div>
                        <div class="pw-strength"><div class="pw-strength-fill" id="pwBar"></div></div>
                        <div class="pw-hint" id="pwHint">Enter a password</div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="so-form-group">
                        <label class="so-label"><i class="fas fa-key"></i> Confirm Password</label>
                        <div class="pw-wrap">
                            @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "so-input", id = "pwConfirm", placeholder = "Repeat password", autocomplete = "new-password" })
                            <i class="fas fa-eye pw-eye" onclick="togglePw('pwConfirm', this)"></i>
                        </div>
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                </div>
            </div>

            <!-- Actions -->
            <div style="display:flex;align-items:center;gap:1rem;margin-top:1.4rem;flex-wrap:wrap;padding:1rem">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-user-plus"></i> Submit Application
                </button>
                <a href="@Url.Action("Home", "Authentication")" class="btn btn-outline btn-lg">
                    Cancel
                </a>
            </div>
        </div>
    }

</main>


