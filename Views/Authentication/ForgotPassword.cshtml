@model SkyTech.Models.Auth.ForgotPasswordViewModel
@{
    ViewBag.Title = "ForgotPassword";
}



@using (Html.BeginForm("ForgotPassword", "Authentication", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group">
        @Html.LabelFor(m => m.UserEmail)
        @Html.TextBoxFor(m => m.UserEmail, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UserEmail, "", new { @class = "text-danger" })
    </div>
    <button type="submit" class="btn btn-primary">Send OTP</button>
}


