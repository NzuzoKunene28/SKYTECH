@model IEnumerable<SkyTech.Models.LeaseProduct>
@{
    ViewData["Title"] = "My Leasable Products";

    string StatusClass(SkyTech.Models.LeaseUnitStatus s) => s switch
    {
        SkyTech.Models.LeaseUnitStatus.Available => "vlp-unit-available",
        SkyTech.Models.LeaseUnitStatus.Reserved => "vlp-unit-reserved",
        SkyTech.Models.LeaseUnitStatus.OnLease => "vlp-unit-onlease",
        SkyTech.Models.LeaseUnitStatus.Maintenance => "vlp-unit-maintenance",
        SkyTech.Models.LeaseUnitStatus.Retired => "vlp-unit-retired",
        _ => ""
    };
}

<style>
    .vlp-page { padding: 32px 20px 60px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; max-width: 1080px; margin: 0 auto; color: #1b2a2f; }
    .vlp-title { font-weight: 800; font-size: 1.4rem; margin: 0 0 4px; }
    .vlp-subtitle { color: #6b8481; font-size: 0.9rem; margin: 0 0 24px; }

    .vlp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }
    .vlp-card {
        background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.07);
        transition: box-shadow .2s ease, transform .2s ease;
        opacity: 0; transform: translateY(14px); animation: vlp-fade-up .4s ease forwards;
    }
    .vlp-card:hover { box-shadow: 0 12px 30px rgba(61,120,115,0.18); transform: translateY(-3px); }

    .vlp-photo { width: 100%; height: 160px; background: #eaf5f4; display: flex; align-items: center; justify-content: center; color: #4a8f8c; overflow: hidden; }
    .vlp-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
    .vlp-card:hover .vlp-photo img { transform: scale(1.05); }

    .vlp-body { padding: 16px 18px; }
    .vlp-name { font-weight: 700; font-size: 1rem; margin-bottom: 2px; }
    .vlp-rate { color: #6b8481; font-size: 0.86rem; margin-bottom: 12px; }

    .vlp-summary { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .vlp-summary-chip { font-size: 0.74rem; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
    .vlp-chip-available { background: #eafaf0; color: #1e7a44; }
    .vlp-chip-onlease { background: #dcf0ef; color: #3d7873; }
    .vlp-chip-other { background: #eef1f0; color: #6b8481; }

    .vlp-units { border-top: 1px solid #eef1f0; padding-top: 10px; display: flex; flex-direction: column; gap: 6px; max-height: 140px; overflow-y: auto; }
    .vlp-unit-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; }
    .vlp-unit-serial { color: #445; }
    .vlp-unit-status { font-size: 0.7rem; font-weight: 700; padding: 2px 9px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.3px; }
    .vlp-unit-available { background: #eafaf0; color: #1e7a44; }
    .vlp-unit-reserved { background: #fdf0dc; color: #a35c00; }
    .vlp-unit-onlease { background: #dcf0ef; color: #3d7873; }
    .vlp-unit-maintenance { background: #fdeceb; color: #b3261e; }
    .vlp-unit-retired { background: #eef1f0; color: #6b8481; }

    .vlp-empty { text-align: center; padding: 50px; color: #6b8481; background: #fff; border-radius: 16px; box-shadow: 0 6px 20px rgba(0,0,0,0.06); }

    @@keyframes vlp-fade-up { to { opacity: 1; transform: translateY(0); } }
</style>

<div class="vlp-page">
    <div class="vlp-title">My Leasable Products</div>
    <div class="vlp-subtitle">Every unit and its current status &mdash; units flip back to Available automatically once a return's deposit refund is processed.</div>

    @if (!Model.Any())
    {
        <div class="vlp-empty">You haven't added any leasable products yet.</div>
    }
    else
    {
        <div class="vlp-grid">
            @{ int delay = 0; }
            @foreach (var product in Model)
            {
                var photo = product.LeaseProductPictures.FirstOrDefault();
                int available = product.LeaseUnits.Count(u => u.Status == SkyTech.Models.LeaseUnitStatus.Available);
                int onLease = product.LeaseUnits.Count(u => u.Status == SkyTech.Models.LeaseUnitStatus.OnLease);
                int other = product.LeaseUnits.Count - available - onLease;

                <div class="vlp-card" style="animation-delay:@(delay)ms;">
                    <div class="vlp-photo">
                        @if (photo != null)
                        {
                            <img src="@photo.FilePath" alt="@product.LeaseProdName" />
                        }
                        else
                        {
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /></svg>
                        }
                    </div>
                    <div class="vlp-body">
                        <div class="vlp-name">@product.LeaseProdName</div>
                        <div class="vlp-rate">R@(product.MonthlyRate.ToString("N2"))/mo &middot; R@(product.SecurityDeposit.ToString("N2")) deposit</div>

                        <div class="vlp-summary">
                            <span class="vlp-summary-chip vlp-chip-available">@available available</span>
                            <span class="vlp-summary-chip vlp-chip-onlease">@onLease on lease</span>
                            @if (other > 0)
                            {
                                <span class="vlp-summary-chip vlp-chip-other">@other other</span>
                            }
                        </div>

                        <div class="vlp-units">
                            @foreach (var unit in product.LeaseUnits)
                            {
                                <div class="vlp-unit-row">
                                    <span class="vlp-unit-serial">@unit.SerialNumber</span>
                                    <span class="vlp-unit-status @StatusClass(unit.Status)">@unit.Status</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                delay += 50;
            }
        </div>
    }
</div>
