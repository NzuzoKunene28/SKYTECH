@using SkyTech.Models
@model IEnumerable<SkyTech.Models.AddProduct>
@{
    ViewBag.Title = "Track Stock";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "Stock";
    bool restricted = ViewBag.ApplicationStatus == ApplicationStat.Pending
                  || ViewBag.ApplicationStatus == ApplicationStat.Rejected;
    int totalProds = Model.Count();
    int inStock = Model.Count(p => p.Status == ProdStatus.In_Stock);
    int lowStock = Model.Count(p => p.Status == ProdStatus.Low_stock);
    int outOfStock = Model.Count(p => p.Status == ProdStatus.Out_Of_Stock);
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <style>
        /* ── Summary chips ── */
        .chip-row {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-bottom: 1.8rem;
        }

        .chip {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-sm);
            padding: .65rem 1.2rem;
            font-size: .82rem;
            font-weight: 700;
            color: var(--text-2);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            gap: .55rem;
            cursor: pointer;
            transition: box-shadow .18s;
        }

            .chip:hover {
                box-shadow: var(--shadow-md);
            }

            .chip .n {
                font-family: var(--font-display);
                font-size: 1.35rem;
                font-weight: 700;
            }

            .chip.all .n {
                color: var(--text);
            }

            .chip.green .n {
                color: var(--green);
            }

            .chip.green {
                border-color: rgba(22,163,74,.28);
            }

            .chip.yellow .n {
                color: var(--yellow);
            }

            .chip.yellow {
                border-color: rgba(217,119,6,.28);
            }

            .chip.red .n {
                color: var(--red);
            }

            .chip.red {
                border-color: rgba(220,38,38,.28);
            }

        /* ── Product card grid ── */
        .prod-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill,minmax(270px,1fr));
            gap: 1.2rem;
        }

        .prod-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: box-shadow .2s,border-color .2s;
            display: flex;
            flex-direction: column;
        }

            .prod-card:hover {
                box-shadow: var(--shadow-md);
                border-color: rgba(26,115,232,.3);
            }

            .prod-card.low-stock {
                border-color: rgba(217,119,6,.4);
            }

            .prod-card.out-stock {
                border-color: rgba(220,38,38,.35);
                opacity: .82;
            }

        /* Image area */
        .pc-img-wrap {
            position: relative;
            height: 160px;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .pc-img-wrap img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                transition: transform .3s;
            }

        .prod-card:hover .pc-img-wrap img {
            transform: scale(1.04);
        }

        .pc-img-wrap i {
            font-size: 2.5rem;
            color: var(--blue);
            opacity: .18;
        }

        /* Stock pill overlay */
        .stock-pill {
            position: absolute;
            top: .6rem;
            right: .6rem;
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: .22rem .65rem;
            border-radius: 20px;
            font-size: .7rem;
            font-weight: 700;
            letter-spacing: .3px;
        }

            .stock-pill::before {
                content: '';
                width: 5px;
                height: 5px;
                border-radius: 50%;
            }

            .stock-pill.in {
                background: rgba(22,163,74,.12);
                color: #15803d;
                border: 1px solid rgba(22,163,74,.3);
            }

                .stock-pill.in::before {
                    background: var(--green);
                }

            .stock-pill.low {
                background: rgba(217,119,6,.12);
                color: #92400e;
                border: 1px solid rgba(217,119,6,.3);
            }

                .stock-pill.low::before {
                    background: var(--yellow);
                }

            .stock-pill.out {
                background: rgba(220,38,38,.10);
                color: #b91c1c;
                border: 1px solid rgba(220,38,38,.28);
            }

                .stock-pill.out::before {
                    background: var(--red);
                }

        /* Category tag */
        .pc-cat {
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            color: var(--blue);
            background: var(--blue-soft);
            border: 1px solid rgba(26,115,232,.2);
            border-radius: 20px;
            padding: .18rem .6rem;
            display: inline-block;
        }

        /* Card body */
        .pc-body {
            padding: 1rem 1.1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }

        .pc-name {
            font-family: var(--font-display);
            font-size: .98rem;
            font-weight: 700;
            color: var(--text);
            line-height: 1.3;
        }

        .pc-desc {
            font-size: .78rem;
            color: var(--text-muted);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .pc-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: .4rem;
        }

        .pc-price {
            font-family: var(--font-display);
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--blue-dark);
        }

        .pc-size {
            font-size: .75rem;
            color: var(--text-muted);
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: .15rem .55rem;
        }

        /* Detail rows inside card */
        .pc-details {
            display: flex;
            flex-direction: column;
            gap: .18rem;
            padding: .6rem 1.1rem;
            border-top: 1px solid var(--border);
        }

        .pc-detail {
            display: flex;
            justify-content: space-between;
            font-size: .78rem;
        }

            .pc-detail .dk {
                color: var(--text-muted);
                font-weight: 600;
            }

            .pc-detail .dv {
                font-weight: 700;
                color: var(--text-2);
            }

        .dv.qty-low {
            color: var(--yellow);
        }

        .dv.qty-out {
            color: var(--red);
        }

        .dv.qty-ok {
            color: var(--green);
        }

        /* Card footer */
        .pc-foot {
            padding: .75rem 1.1rem;
            display: flex;
            gap: .55rem;
            border-top: 1px solid var(--border);
        }

        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 5rem 2rem;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 3.5rem;
                opacity: .18;
                display: block;
                margin-bottom: 1rem;
            }

            .empty-state p {
                font-weight: 600;
            }
    </style>
}
@section Scripts {
   
    <script>
        // Toggle dropdown for Received Orders
        const dropdownToggle = document.getElementById('ordersDropdown');
        const dropdownMenu = document.getElementById('ordersSubmenu');

        if (dropdownToggle && dropdownMenu) {
            dropdownToggle.addEventListener('click', function(e) {
                e.preventDefault();
                this.classList.toggle('open');
                dropdownMenu.classList.toggle('show');
            });

            // Keep submenu open if a sub-link is active
            if (window.location.href.includes('DeliveryOrders') || window.location.href.includes('PickupOrders')) {
                dropdownToggle.classList.add('open');
                dropdownMenu.classList.add('show');
            }
        }
    </script>

}
<div class="so-wrap">

    <!-- SIDEBAR -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">SkyTech</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>

            <a href="@Url.Action("ShopOwnerDash", "ShopOwner")" class="so-link active"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>

            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>

            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>

            <!-- Received Orders with submenu -->
            <div class="nav-item-dropdown">
                <a href="#" class="so-link so-dropdown-toggle @(restricted ? "disabled-link" : "")" id="ordersDropdown">
                    <i class="fas fa-bag-shopping"></i>
                    <span>Received Orders</span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </a>
                <div class="so-dropdown-menu" id="ordersSubmenu">
                    <a href="@Url.Action("DeliveryOrders", "ShopOwner")" class="so-link so-sub-link @(restricted ? "disabled-link" : "")">
                        <i class="fas fa-truck"></i> Delivery Orders
                    </a>
                    <a href="@Url.Action("PickupOrders", "ShopOwner")" class="so-link so-sub-link @(restricted ? "disabled-link" : "")">
                        <i class="fas fa-store"></i> In-Store Collection
                    </a>
                </div>
            </div>

            <a href="@Url.Action("StaffReg", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-users"></i><span>Staff Members</span></a>

            <a href="@Url.Action("ReturnedItems","ShopOwner")" class="so-link @(restricted?"disabled-link":"")"><i class="fas fa-bag-shopping"></i><span>Returned Items</span></a>
            <a href="@Url.Action("StaffReg","ShopOwner")" class="so-link @(restricted?"disabled-link":"")"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers","ShopOwner")" class="so-link @(restricted?"disabled-link":"")"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile", "ShopOwner")" class="so-link"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-role">SkyTech</div>
            </div>
        </div>

        <!--Logout button-->
        <div style="padding:.8rem 1.2rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(239,68,68,.08);
                    border:1.5px solid rgba(239,68,68,.25);border-radius:8px;
                    padding:.6rem 1rem;cursor:pointer;color:#ef4444;
                    font-weight:600;font-size:.85rem;display:flex;
                    align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>


    <!-- ── MAIN ── -->
    <main class="so-main">

        <!-- Topbar -->
        <div class="so-topbar">
            <div>
                <div class="so-page-title">Track Stock</div>
                <div class="so-page-sub">Monitor inventory levels across all your products.</div>
            </div>
            <a href="@Url.Action("AddProductPage","ShopOwner")" class="btn btn-primary">
                <i class="fas fa-circle-plus"></i> Add Product
            </a>
        </div>

        <!-- Summary chips -->
        <div class="chip-row">
            <div class="chip all" onclick="filterCards('all')">
                <i class="fas fa-boxes-stacked" style="color:var(--text-muted)"></i>
                <span class="n">@totalProds</span> Total Products
            </div>
            <div class="chip green" onclick="filterCards('in')">
                <i class="fas fa-circle-check" style="color:var(--green)"></i>
                <span class="n">@inStock</span> In Stock
            </div>
            <div class="chip yellow" onclick="filterCards('low')">
                <i class="fas fa-triangle-exclamation" style="color:var(--yellow)"></i>
                <span class="n">@lowStock</span> Low Stock
            </div>
            <div class="chip red" onclick="filterCards('out')">
                <i class="fas fa-circle-xmark" style="color:var(--red)"></i>
                <span class="n">@outOfStock</span> Out of Stock
            </div>
        </div>

        <!-- Search bar -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.4rem">
            <div class="so-search" style="max-width:320px;width:100%">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="prodSearch" placeholder="Search products…" oninput="filterCards('search', this.value)">
            </div>
            <span id="resultCount" style="font-size:.82rem;color:var(--text-muted);font-weight:600">
                Showing @totalProds product@(totalProds != 1 ? "s" : "")
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="so-card">
                <div class="empty-state">
                    <i class="fas fa-boxes-stacked"></i>
                    <p>You haven't added any products yet.</p>
                    <a href="@Url.Action("AddProductPage","ShopOwner")" class="btn btn-primary" style="margin-top:1rem">
                        <i class="fas fa-circle-plus"></i> Add Your First Product
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="prod-grid" id="prodGrid">
                @foreach (var item in Model)
                {
                    string statusKey = item.Status == ProdStatus.In_Stock ? "in"
                                     : item.Status == ProdStatus.Low_stock ? "low"
                                                                            : "out";
                    string cardClass = item.Status == ProdStatus.Low_stock ? "low-stock"
                                     : item.Status == ProdStatus.Out_Of_Stock ? "out-stock"
                                                                              : "";
                    string pillClass = item.Status == ProdStatus.In_Stock ? "in"
                                     : item.Status == ProdStatus.Low_stock ? "low"
                                                                            : "out";
                    string pillText = item.Status == ProdStatus.In_Stock ? "In Stock"
                                     : item.Status == ProdStatus.Low_stock ? "Low Stock"
                                                                            : "Out of Stock";
                    string qtyClass = item.ProdQuantity == 0 ? "qty-out"
                                     : item.ProdQuantity <= 5 ? "qty-low"
                                                              : "qty-ok";

                    <div class="prod-card @cardClass"
                         data-status="@statusKey"
                         data-name="@item.ProdName.ToLower()">

                        <!-- Image -->
                        <div class="pc-img-wrap">
                            @if (item.ProductPictures != null && item.ProductPictures.Any())
                            {
                                var pic = item.ProductPictures.First();
                                 <img src="@pic.FilePath" alt="@pic.FileName" />
                            }
                            else
                            {
                                <i class="fas fa-image"></i>
                            }
                            <span class="stock-pill @pillClass">@pillText</span>
                        </div>

                        <!-- Body -->
                        <div class="pc-body">
                            <span class="pc-cat">@item.ProdCategory</span>
                            <div class="pc-name">@item.ProdName</div>
                            @if (!string.IsNullOrEmpty(item.ProdDescription))
                            {
                                <div class="pc-desc">@item.ProdDescription</div>
                            }
                            <div class="pc-meta">
                                <span class="pc-price">R @item.ProdPrice.ToString("N2")</span>
                                @if (!string.IsNullOrEmpty(item.ProdSize))
                                {
                                    <span class="pc-size">@item.ProdSize</span>
                                }
                            </div>
                        </div>

                        <!-- Detail rows -->
                        <div class="pc-details">
                            <div class="pc-detail">
                                <span class="dk"><i class="fas fa-circle" style="font-size:.45rem;margin-right:.35rem;color:var(--text-muted)"></i>Status</span>
                                <span class="dv @(item.Status==ProdStatus.In_Stock?"qty-ok":item.Status==ProdStatus.Low_stock?"qty-low":"qty-out")">
                                    @item.Status.ToString().Replace("_", " ")
                                </span>
                            </div>
                            <div class="pc-detail">
                                <span class="dk"><i class="fas fa-hashtag" style="font-size:.65rem;margin-right:.3rem;color:var(--text-muted)"></i>Stock Qty</span>
                                <span class="dv @qtyClass">@item.ProdQuantity units</span>
                            </div>
                        </div>

                        <!-- Footer actions -->
                        <div class="pc-foot">
                            <a href="@Url.Action("EditProductPage","ShopOwner",new{id=item.ProdId})"
                               class="btn btn-outline btn-sm" style="flex:1;justify-content:center">
                                <i class="fas fa-pen"></i> update product
                            </a>
                        </div>

                    </div>
                }
            </div>
        }

    </main>
</div>

<script>var activeFilter = 'all';
var searchTerm   = '';

function filterCards(type, val) {
    if (type === 'search') {
        searchTerm = (val || '').toLowerCase();
    } else {
        activeFilter = type;
        // toggle chip active style
        document.querySelectorAll('.chip').forEach(function(c) { c.style.boxShadow = ''; });
        event.currentTarget.style.boxShadow = '0 0 0 2px var(--blue)';
    }

    var cards   = document.querySelectorAll('.prod-card');
    var visible = 0;
    cards.forEach(function(card) {
        var matchFilter = activeFilter === 'all' || card.dataset.status === activeFilter;
        var matchSearch = !searchTerm   || (card.dataset.name || '').includes(searchTerm);
        var show = matchFilter && matchSearch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    var rc = document.getElementById('resultCount');
    if (rc) rc.textContent = 'Showing ' + visible + ' product' + (visible !== 1 ? 's' : '');
}</script>
