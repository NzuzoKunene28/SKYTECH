@model SkyTech.Models.LeaseAgreementItem
@{
    ViewData["Title"] = "Inspect Returned Equipment";
    bool hasAssessment = Model.AiDamageAssessment.HasValue;
    var originalPhoto = Model.LeaseUnit?.LeaseProduct?.LeaseProductPictures?.FirstOrDefault();
}

<style>
    .insp-page { padding: 32px 20px 60px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; max-width: 760px; margin: 0 auto; color: #1b2a2f; }
    .insp-card { background: #fff; border: 1px solid #e1eeec; border-radius: 16px; padding: 26px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); margin-bottom: 20px; opacity: 0; transform: translateY(14px); animation: insp-fade-up .4s ease forwards; }
    .insp-title { font-weight: 800; font-size: 1.25rem; margin: 0 0 4px; }
    .insp-sub { color: #6b8481; font-size: 0.88rem; margin: 0 0 20px; }
    .insp-msg { background: #eaf5f4; border: 1px solid #d7ece9; color: #3d7873; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.9rem; }
    .insp-error { background: #fdeceb; border: 1px solid #f3bcb9; color: #b3261e; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; font-size: 0.9rem; }

    .insp-photo-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 20px; }
    .insp-photo-box { text-align: center; }
    .insp-photo-box img {
        width: 100%; height: 220px; object-fit: contain; background: #f5f7f6;
        border: 1px solid #e1eeec; border-radius: 12px; display: block;
        transition: transform .25s ease;
    }
    .insp-photo-box:hover img { transform: scale(1.03); }
    .insp-photo-label { font-size: 0.76rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #6b8481; margin-top: 8px; }
    .insp-photo-placeholder { width: 100%; height: 220px; background: #f5f7f6; border: 1px dashed #d7e0de; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #a3b0ad; font-size: 0.85rem; }

    @@media (max-width: 560px) { .insp-photo-compare { grid-template-columns: 1fr; } }

    .insp-field { margin-bottom: 14px; }
    .insp-field label { display: block; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; color: #6b8481; margin-bottom: 6px; }
    .insp-field input, .insp-field textarea { width: 100%; padding: 10px 12px; border: 1px solid #e1eeec; border-radius: 8px; font-family: inherit; font-size: 0.9rem; box-sizing: border-box; transition: border-color .15s ease; }
    .insp-field input:focus, .insp-field textarea:focus { outline: none; border-color: #4a8f8c; }
    .insp-btn { background: #4a8f8c; color: #fff; border: none; border-radius: 8px; padding: 11px 22px; font-weight: 700; font-size: 0.88rem; cursor: pointer; transition: filter .15s ease, transform .1s ease; }
    .insp-btn:hover { filter: brightness(1.08); }
    .insp-btn:active { transform: scale(0.97); }
    .insp-btn[disabled] { opacity: 0.7; cursor: wait; }

    .insp-ai-box { background: #fff7e6; border: 1px solid #f3d98b; border-radius: 10px; padding: 16px 18px; margin-bottom: 18px; font-size: 0.9rem; line-height: 1.6; }
    .insp-ai-badge { display: inline-block; background: #b7791f; color: #fff; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; padding: 3px 9px; border-radius: 999px; margin-bottom: 8px; }
    .insp-confidence-bar { background: #f0e2bd; border-radius: 999px; height: 6px; margin: 6px 0 10px; overflow: hidden; }
    .insp-confidence-fill { height: 100%; background: #b7791f; border-radius: 999px; transition: width .6s ease; }

    .insp-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.5); border-top-color: #fff; border-radius: 50%; animation: insp-spin .7s linear infinite; margin-right: 8px; vertical-align: -2px; }

    @@keyframes insp-fade-up { to { opacity: 1; transform: translateY(0); } }
    @@keyframes insp-spin { to { transform: rotate(360deg); } }
</style>

<div class="insp-page">
    @if (TempData["Message"] != null)
    {
        <div class="insp-msg">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="insp-error">@TempData["Error"]</div>
    }

    <div class="insp-card">
        <div class="insp-title">Inspect: @(Model.LeaseUnit?.LeaseProduct?.LeaseProdName ?? "Item")</div>
        <div class="insp-sub">Serial: @Model.LeaseUnit?.SerialNumber &middot; Deposit at lease: R@(Model.DepositAtLease.ToString("N2"))</div>

        @if (Model.ReturnStatus != SkyTech.Models.LeaseReturnStatus.Item_Collected)
        {
            <p style="color:#6b8481;font-size:0.9rem;">This item hasn't been marked as received yet &mdash; do that from Pending Returns first.</p>
        }
        else
        {
            <div class="insp-photo-compare">
                <div class="insp-photo-box">
                    @if (originalPhoto != null)
                    {
                        <img src="@originalPhoto.FilePath" alt="Original listing photo" />
                    }
                    else
                    {
                        <div class="insp-photo-placeholder">No original photo on file</div>
                    }
                    <div class="insp-photo-label">Original Listing Photo</div>
                </div>
                <div class="insp-photo-box">
                    @if (Model.ReturnConditionImagePath != null)
                    {
                        <img src="@Model.ReturnConditionImagePath" alt="Condition photo submitted by customer" />
                    }
                    else
                    {
                        <div class="insp-photo-placeholder">No condition photo submitted</div>
                    }
                    <div class="insp-photo-label">Customer's Return Photo</div>
                </div>
            </div>

            @if (hasAssessment)
            {
                <div class="insp-ai-box">
                    <span class="insp-ai-badge">AI Assessment</span><br />
                    <strong>Condition:</strong> @Model.AiDamageAssessment &nbsp; (@Model.AiConfidencePercent% confidence)
                    <div class="insp-confidence-bar"><div class="insp-confidence-fill" style="width:@(Model.AiConfidencePercent)%;"></div></div>
                    <strong>Suggested damage fee:</strong> R@(Model.AiSuggestedDamageFee?.ToString("N2"))<br />
                    <strong>Notes:</strong> @Model.AiNotes
                </div>
            }
            else
            {
                <div class="insp-error">No automated assessment is available for this item (it may have been scheduled before this feature existed). Enter the damage fee manually below.</div>
            }

            <form method="post" action="@Url.Action("ConfirmInspection")" class="insp-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="leaseAgreementItemId" value="@Model.LeaseAgreementItemId" />

                <div class="insp-field">
                    <label for="finalDamageFee">Final Damage Fee@(hasAssessment ? " (edit if you disagree with the AI)" : "")</label>
                    <input type="number" step="0.01" id="finalDamageFee" name="finalDamageFee"
                           value="@(Model.AiSuggestedDamageFee ?? 0)" required>
                </div>

                <div class="insp-field">
                    <label for="overrideReason">Reason for change (only needed if you edited the fee above)</label>
                    <textarea id="overrideReason" name="overrideReason" rows="2"></textarea>
                </div>

                <button type="submit" class="insp-btn">Confirm Inspection</button>
            </form>
        }
    </div>
</div>

<script>
    const inspForm = document.querySelector('.insp-form');
    if (inspForm) {
        inspForm.addEventListener('submit', () => {
            const btn = inspForm.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="insp-spinner"></span> Confirming...';
        });
    }
</script>
