@using SkyTech.Models
@model SkyTech.Models.ProposeItem

@section Styles {
    <link rel="stylesheet" href="~/CSS/AcceptProposalModal.css">

}

<div class="modal-backdrop" onclick="closeModal()"></div>

<div class="modal-box">

    <div class="modal-header">
        <h4>💰 Set Proposed Amount</h4>
        <p>Enter the amount you'd like to offer for this item</p>
    </div>

    <div class="modal-body">

        <div class="modal-prod-info">
            📦 @Model.ProdName
        </div>

        <form asp-action="AcceptProposal" asp-controller="ShopOwner" method="post">
            <input type="hidden" name="id" value="@Model.PropItemId" />

            <div class="amount-group">
                <div class="amount-label">Proposed Amount</div>
                <div class="amount-wrap">
                    <span class="amount-prefix">R</span>
                    <input type="number"
                           name="amount"
                           class="amount-input"
                           placeholder="0.00"
                           step="0.01"
                           min="0"
                           required
                           autofocus />
                </div>
            </div>

            <div class="modal-actions">
                <button type="button" class="modal-btn-cancel" onclick="closeModal()">Cancel</button>
                <button type="submit" class="modal-btn-submit">Submit Offer ✓</button>
            </div>
        </form>

    </div>
</div>

<script>
    function closeModal() {
        document.getElementById('modalContainer').innerHTML = '';
    }
</script>
