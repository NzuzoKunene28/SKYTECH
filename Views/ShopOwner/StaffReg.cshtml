@model SkyTech.ViewModels.StaffViewModel
@{
    ViewBag.Title = "Register Staff";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    ViewBag.ActivePage = "StaffReg";
    bool restricted = ViewBag.ApplicationStatus == ApplicationStat.Pending
                  || ViewBag.ApplicationStatus == ApplicationStat.Rejected;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShopOwnerStyle.css">
    <link rel="stylesheet" href="~/CSS/RegistrationForms.css">
    <script src="~/MyScripts/PasswordProgressBar.js"></script>


}
@section Scripts {
   
    <script>
        // Toggle dropdown for Received Orders
        const dropdownToggle = document.getElementById('ordersDropdown');
        const dropdownMenu = document.getElementById('ordersSubmenu');

        if (dropdownToggle && dropdownMenu) {
            dropdownToggle.addEventListener('click', function(e) {
                e.preventDefault();
                this.classList.toggle('open');
                dropdownMenu.classList.toggle('show');
            });

            // Keep submenu open if a sub-link is active
            if (window.location.href.includes('DeliveryOrders') || window.location.href.includes('PickupOrders')) {
                dropdownToggle.classList.add('open');
                dropdownMenu.classList.add('show');
            }
        }
    </script>

}
<div class="so-wrap">

    <!-- SIDEBAR -->
    <aside class="so-sidebar">
        <div class="so-brand">
            <div class="so-brand-icon"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-brand-name">SkyTech</div>
                <div class="so-brand-sub">Shop Owner Portal</div>
            </div>
        </div>
        <nav class="so-nav">
            <div class="so-nav-label">OVERVIEW</div>

            <a href="@Url.Action("ShopOwnerDash", "ShopOwner")" class="so-link active"><i class="fas fa-grid-2"></i><span>Dashboard</span></a>

            <div class="so-nav-label" style="margin-top:1rem">INVENTORY</div>
            <a href="@Url.Action("AddProductPage", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-circle-plus"></i><span>Add Product</span></a>
            <a href="@Url.Action("TrackStockLevelPage", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-boxes-stacked"></i><span>Track Stock</span></a>

            <div class="so-nav-label" style="margin-top:1rem">ORDERS & STAFF</div>

            <!-- Received Orders with submenu -->
            <div class="nav-item-dropdown">
                <a href="#" class="so-link so-dropdown-toggle @(restricted ? "disabled-link" : "")" id="ordersDropdown">
                    <i class="fas fa-bag-shopping"></i>
                    <span>Received Orders</span>
                    <i class="fas fa-chevron-down dropdown-icon"></i>
                </a>
                <div class="so-dropdown-menu" id="ordersSubmenu">
                    <a href="@Url.Action("DeliveryOrders", "ShopOwner")" class="so-link so-sub-link @(restricted ? "disabled-link" : "")">
                        <i class="fas fa-truck"></i> Delivery Orders
                    </a>
                    <a href="@Url.Action("PickupOrders", "ShopOwner")" class="so-link so-sub-link @(restricted ? "disabled-link" : "")">
                        <i class="fas fa-store"></i> In-Store Collection
                    </a>
                </div>
            </div>

            <a href="@Url.Action("StaffReg", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-users"></i><span>Staff Members</span></a>

            <a href="@Url.Action("ReturnedItems", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-bag-shopping"></i><span>Returned Items</span></a>
            <a href="@Url.Action("StaffReg", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-user-plus"></i><span>Register Staff</span></a>
            <a href="@Url.Action("StaffMembers", "ShopOwner")" class="so-link @(restricted ? "disabled-link" : "")"><i class="fas fa-users"></i><span>Staff Members</span></a>
            <div class="so-nav-label" style="margin-top:1rem">ACCOUNT</div>
            <a href="@Url.Action("OwnerProfile", "ShopOwner")" class="so-link"><i class="fas fa-circle-user"></i><span>Profile</span></a>
        </nav>
        <div class="so-sidebar-foot">
            <div class="so-foot-avatar"><i class="fas fa-store"></i></div>
            <div>
                <div class="so-foot-role">SkyTech</div>
            </div>
        </div>

        <!--Logout button-->
        <div style="padding:.8rem 1.2rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(239,68,68,.08);
                    border:1.5px solid rgba(239,68,68,.25);border-radius:8px;
                    padding:.6rem 1rem;cursor:pointer;color:#ef4444;
                    font-weight:600;font-size:.85rem;display:flex;
                    align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>

    <!-- ── MAIN ── -->
    <main class="so-main">

        @if (TempData["Message"] != null)
        {
            <div class="so-alert so-alert-success"><i class="fas fa-circle-check"></i> @TempData["Message"]</div>
        }

        <!-- Topbar -->
        <div class="so-topbar">
            <div>
                <div class="so-page-title">Register Staff</div>
                <div class="so-page-sub">Create a new staff account for your shop.</div>
            </div>
            <a href="@Url.Action("StaffMembers","ShopOwner")" class="btn btn-outline">
                <i class="fas fa-users"></i> View Staff
            </a>
        </div>

        @using (Html.BeginForm("StaffReg", "ShopOwner", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "so-alert so-alert-error" })

            <!-- Personal details -->
            <div class="so-card" style="margin-bottom:1.2rem">
                <div class="so-card-head">
                    <div class="so-card-title">
                        <i class="fas fa-user" style="color:var(--blue);margin-right:.4rem"></i>Personal Details
                    </div>
                </div>
                <div class="so-card-body">
                    <div class="so-form-grid">

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-pen"></i> First Name</label>
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "so-input", placeholder = "e.g. Thabo", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-pen"></i> Last Name</label>
                            @Html.TextBoxFor(m => m.LastName, new { @class = "so-input", placeholder = "e.g. Mokoena", maxlength = "100" })
                            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-envelope"></i> Email Address</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "so-input", placeholder = "staff@example.com", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-phone"></i> Phone Number</label>
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "so-input", placeholder = "0812345678", maxlength = "10", type = "tel" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                        </div>

                    </div>
                </div>
            </div>

            <!-- Account credentials -->
            <div class="so-card">
                <div class="so-card-head">
                    <div class="so-card-title">
                        <i class="fas fa-lock" style="color:var(--blue);margin-right:.4rem"></i>Account Credentials
                    </div>
                </div>
                <div class="so-card-body">
                    <div class="so-form-grid">

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-key"></i> Password</label>
                            <div class="pw-wrap">
                                @Html.PasswordFor(m => m.Password, new { @class = "so-input", id = "pwField", placeholder = "Min. 8 characters", autocomplete = "new-password" })
                                <i class="fas fa-eye pw-eye" onclick="togglePw('pwField', this)"></i>
                            </div>
                            <div class="pw-strength"><div class="pw-strength-fill" id="pwBar"></div></div>
                            <div class="pw-hint" id="pwHint">Enter a password</div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                        </div>

                        <div class="so-form-group">
                            <label class="so-label"><i class="fas fa-key"></i> Confirm Password</label>
                            <div class="pw-wrap">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "so-input", id = "pwConfirm", placeholder = "Repeat password", autocomplete = "new-password" })
                                <i class="fas fa-eye pw-eye" onclick="togglePw('pwConfirm', this)"></i>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                        </div>

                    </div>

                    <!-- Info tip -->
                    <div class="so-alert so-alert-info" style="margin-top:1.2rem;margin-bottom:0">
                        <i class="fas fa-circle-info"></i>
                        A confirmation email will be sent to the staff member once registered. They can change their password after first login.
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div style="display:flex;align-items:center;gap:1rem;margin-top:1.4rem;flex-wrap:wrap">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="fas fa-user-plus"></i> Register Staff Member
                </button>
                <a href="@Url.Action("StaffMembers","ShopOwner")" class="btn btn-outline btn-lg">
                    Cancel
                </a>
            </div>
        }

    </main>
</div>