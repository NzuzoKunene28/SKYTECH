@model SkyTech.Models.Interviews.Interview
@{
    var roomName = Model.JitsiMeetingLink?.Split('/').LastOrDefault();
    var redirectController = ViewData["RedirectController"] as string ?? "Recruitment";
    var redirectAction = ViewData["RedirectAction"] as string ?? "ScheduledInterviews";
    var needsId = ViewData["RedirectNeedsId"] as bool? ?? false;

    var redirectUrl = needsId
        ? Url.Action(redirectAction, redirectController, new { id = Model.InterviewId })
        : Url.Action(redirectAction, redirectController);
}

<div id="jitsi-container" style="height: 700px; width: 100%; border-radius: 8px; overflow: hidden;"></div>

<script src="https://meet.jit.si/external_api.js"></script>
<script>
    const domain = 'meet.jit.si';
    const options = {
        roomName: '@roomName',
        width: '100%',
        height: 700,
        parentNode: document.querySelector('#jitsi-container'),
        configOverwrite: {
            prejoinPageEnabled: false,
            enableClosePage: false,      // stop Jitsi's own "meeting ended" screen from showing
            disableInviteFunctions: true
        }
    };
    const jitsiApi = new JitsiMeetExternalAPI(domain, options);

    // Fires the instant the local user leaves the call — before Jitsi's own close screen would appear
    jitsiApi.addEventListener('videoConferenceLeft', () => {
        window.location.href = '@redirectUrl';
    });
</script>