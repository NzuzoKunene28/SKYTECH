@model IEnumerable<SkyTech.Models.Repair_Item_Services.RepairAssignment>

@{
    ViewBag.Title = "My Assignments";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DashboardStyle.css">
}

<div class="dash-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="dash-sidebar">
        <div class="dash-brand">
            <div class="dash-brand-icon"><i class="fas fa-tools"></i></div>
            <div>
                <div class="dash-brand-name">SkyTech</div>
                <div class="dash-brand-sub">Technician Portal</div>
            </div>
        </div>
        <nav class="dash-nav">
            <div class="dash-nav-label">OVERVIEW</div>
            <a href="@Url.Action("Dashboard", "Technician")" class="dash-link">
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>

            <div class="dash-nav-label">WORK</div>
            <a href="@Url.Action("MyAssignments", "Technician")" class="dash-link active">
                <i class="fas fa-tasks"></i><span>My Assignments</span>
            </a>
            <a href="@Url.Action("ActiveRepairs", "Technician")" class="dash-link">
                <i class="fas fa-wrench"></i><span>Active Repairs</span>
            </a>
            <a href="@Url.Action("ViewQuotations", "Technician")" class="dash-link">
                <i class="fas fa-file-invoice-dollar"></i><span>Quotations</span>
            </a>
            <a href="@Url.Action("CompletedRepairs", "Technician")" class="dash-link">
                <i class="fas fa-check-double"></i><span>Completed</span>
            </a>

            <div class="dash-nav-label">ACCOUNT</div>
            <a href="@Url.Action("Profile", "Technician")" class="dash-link">
                <i class="fas fa-user"></i><span>Profile</span>
            </a>
        </nav>

        <div class="dash-sidebar-foot">
            <div class="dash-foot-avatar"><i class="fas fa-user-tie"></i></div>
            <div>
                <div class="dash-foot-name">Technician</div>
                <div class="dash-foot-role">Technician</div>
            </div>
        </div>

        <div style="padding:.8rem 1.2rem;margin-top:1rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(220,38,38,.08);border:1.5px solid rgba(220,38,38,.25);border-radius:8px;padding:.6rem 1rem;cursor:pointer;color:#dc2626;font-weight:600;font-size:.85rem;display:flex;align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="dash-main">

        <!-- Top Bar -->
        <div class="dash-topbar">
            <div>
                <div class="dash-page-title">My Assignments</div>
                <div class="dash-page-sub">View and manage all your repair assignments</div>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="dash-grid dash-grid-2">
                @foreach (var assignment in Model)
                {
                    var statusBadgeClass = assignment.RepairRequest.Status switch
                    {
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Pending => "dash-badge-warning",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Assigned => "dash-badge-info",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.InProgress => "dash-badge-info",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Completed => "dash-badge-success",
                        _ => "dash-badge-primary"
                    };

                    var statusIcon = assignment.RepairRequest.Status switch
                    {
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Pending => "fas fa-hourglass-start",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Assigned => "fas fa-user-check",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.InProgress => "fas fa-wrench",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Completed => "fas fa-check-circle",
                        _ => "fas fa-question-circle"
                    };

                    <div class="dash-card">
                        <div class="dash-card-head">
                            <div>
                                <div class="dash-card-title">#@assignment.RepairRequest.RequestId - @assignment.RepairRequest.ItemName</div>
                                <div style="font-size:0.85rem;color:var(--text-muted);margin-top:0.3rem">
                                    <i class="fas fa-user" style="margin-right:0.3rem"></i>@assignment.RepairRequest.Customers.FirstName @assignment.RepairRequest.Customers.LastName
                                </div>
                            </div>
                            <span class="dash-badge @statusBadgeClass">
                                <i class="@statusIcon" style="margin-right:0.3rem"></i>@assignment.RepairRequest.Status.ToString()
                            </span>
                        </div>

                        <div style="padding:1rem;background:var(--blue-soft);border-radius:var(--radius-sm);margin-bottom:1rem;border:1px solid var(--border-lit)">
                            <div style="font-size:0.85rem;color:var(--text-muted);font-weight:500;margin-bottom:0.3rem">Issue</div>
                            <div style="font-size:0.95rem;color:var(--text);line-height:1.4">@assignment.RepairRequest.IssueDescription</div>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;margin-bottom:1rem;font-size:0.9rem">
                            <div>
                                <div style="color:var(--text-muted);font-weight:500;margin-bottom:0.2rem">Category</div>
                                <div style="color:var(--text)">@assignment.RepairRequest.Category?.CategoryName</div>
                            </div>
                            <div>
                                <div style="color:var(--text-muted);font-weight:500;margin-bottom:0.2rem">Assigned</div>
                                <div style="color:var(--text)">@assignment.AssignedDate.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:0.6rem">
                            <a href="@Url.Action("RepairDetail", "Technician", new { id = assignment.RepairRequest.RequestId })" class="dash-btn dash-btn-primary" style="flex:1;justify-content:center">
                                <i class="fas fa-arrow-right"></i> View Details
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dash-card" style="text-align:center;padding:3rem">
                <i class="fas fa-inbox" style="font-size:3rem;color:var(--text-muted);opacity:0.5;margin-bottom:1rem;display:block"></i>
                <p style="color:var(--text-muted);font-size:1.1rem">No assignments yet</p>
            </div>
        }

    </main>
</div>
