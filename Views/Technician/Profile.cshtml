@model SkyTech.Models.Repair_Services.Technician

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DashboardStyle.css">
}

<div class="dash-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="dash-sidebar">
        <div class="dash-brand">
            <div class="dash-brand-icon"><i class="fas fa-tools"></i></div>
            <div>
                <div class="dash-brand-name">SkyTech</div>
                <div class="dash-brand-sub">Technician Portal</div>
            </div>
        </div>
        <nav class="dash-nav">
            <div class="dash-nav-label">OVERVIEW</div>
            <a href="@Url.Action("Dashboard", "Technician")" class="dash-link">
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>

            <div class="dash-nav-label">WORK</div>
            <a href="@Url.Action("MyAssignments", "Technician")" class="dash-link">
                <i class="fas fa-tasks"></i><span>My Assignments</span>
            </a>
            <a href="@Url.Action("ActiveRepairs", "Technician")" class="dash-link">
                <i class="fas fa-wrench"></i><span>Active Repairs</span>
            </a>
            <a href="@Url.Action("ViewQuotations", "Technician")" class="dash-link">
                <i class="fas fa-file-invoice-dollar"></i><span>Quotations</span>
            </a>
            <a href="@Url.Action("CompletedRepairs", "Technician")" class="dash-link">
                <i class="fas fa-check-double"></i><span>Completed</span>
            </a>

            <div class="dash-nav-label">ACCOUNT</div>
            <a href="@Url.Action("Profile", "Technician")" class="dash-link active">
                <i class="fas fa-user"></i><span>Profile</span>
            </a>
        </nav>

        <div class="dash-sidebar-foot">
            <div class="dash-foot-avatar"><i class="fas fa-user-tie"></i></div>
            <div>
                <div class="dash-foot-name">@Model.TechnicianFirstName</div>
                <div class="dash-foot-role">Technician</div>
            </div>
        </div>

        <div style="padding:.8rem 1.2rem;margin-top:1rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(220,38,38,.08);border:1.5px solid rgba(220,38,38,.25);border-radius:8px;padding:.6rem 1rem;cursor:pointer;color:#dc2626;font-weight:600;font-size:.85rem;display:flex;align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="dash-main">

        <!-- Top Bar -->
        <div class="dash-topbar">
            <div>
                <div class="dash-page-title">My Profile</div>
                <div class="dash-page-sub">Manage your account and preferences</div>
            </div>
        </div>

        <div class="dash-grid dash-grid-2">
            <!-- Profile Information -->
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">Profile Information</div>
                </div>

                <div style="text-align:center;padding:1rem;margin-bottom:1.4rem">
                    <div style="width:100px;height:100px;background:linear-gradient(135deg,var(--blue),var(--blue-deep));color:var(--white);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin:0 auto;margin-bottom:1rem">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div style="font-size:1.6rem;font-weight:700;color:var(--text)">@Model.TechnicianFirstName @Model.TechnicianLastName</div>
                </div>

                <div style="display:flex;flex-direction:column;gap:1rem">
                    <div style="padding:1rem;background:var(--blue-soft);border-radius:var(--radius-sm);border:1px solid var(--border-lit)">
                        <div style="font-size:0.85rem;color:var(--text-muted);font-weight:500;margin-bottom:0.5rem">
                            <i class="fas fa-tools" style="margin-right:0.5rem;color:var(--blue)"></i>Specialization
                        </div>
                        <div style="font-size:1.1rem;font-weight:600;color:var(--text)">@Model.Category?.CategoryName</div>
                    </div>

                    <div style="padding:1rem;background:var(--blue-soft);border-radius:var(--radius-sm);border:1px solid var(--border-lit)">
                        <div style="font-size:0.85rem;color:var(--text-muted);font-weight:500;margin-bottom:0.5rem">
                            <i class="fas fa-signal" style="margin-right:0.5rem;color:var(--blue)"></i>Availability Status
                        </div>
                        <div style="display:flex;align-items:center;gap:0.6rem">
                            @{
                                var statusIcon = Model.Status switch
                                {
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Available => "fas fa-circle-check",
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Busy => "fas fa-hourglass-half",
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Unavailable => "fas fa-circle-xmark",
                                    _ => "fas fa-question-circle"
                                };

                                var statusColor = Model.Status switch
                                {
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Available => "#16a34a",
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Busy => "#d97706",
                                    SkyTech.Models.Repair_Services.AvailabilityStatus.Unavailable => "#dc2626",
                                    _ => "#5f9ea0"
                                };
                            }
                            <i class="@statusIcon" style="font-size:1.3rem;color:@statusColor"></i>
                            <span style="font-weight:600;color:var(--text)">@Model.Status.ToString()</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Management -->
            <div class="dash-card">
                <div class="dash-card-head">
                    <div class="dash-card-title">Update Your Status</div>
                </div>

                <form asp-action="UpdateStatus" asp-controller="Technician" method="post">
                    <input type="hidden" name="id" value="@Model.TechnicianId" />

                    <div class="dash-form-group">
                        <label class="dash-label">Select Your Availability</label>
                        <select name="Status" class="dash-select">
                            <option value="@SkyTech.Models.Repair_Services.AvailabilityStatus.Available" selected="@(Model.Status == SkyTech.Models.Repair_Services.AvailabilityStatus.Available)">
                                ✓ Available
                            </option>
                            <option value="@SkyTech.Models.Repair_Services.AvailabilityStatus.Busy" selected="@(Model.Status == SkyTech.Models.Repair_Services.AvailabilityStatus.Busy)">
                                ⏳ Busy
                            </option>
                            <option value="@SkyTech.Models.Repair_Services.AvailabilityStatus.Unavailable" selected="@(Model.Status == SkyTech.Models.Repair_Services.AvailabilityStatus.Unavailable)">
                                ✕ Unavailable
                            </option>
                        </select>
                        <div class="dash-help-text">Let store representatives know about your availability</div>
                    </div>

                    <button type="submit" class="dash-btn dash-btn-primary" style="width:100%;justify-content:center">
                        <i class="fas fa-save"></i> Update Status
                    </button>
                </form>

                <div style="margin-top:1.4rem;padding-top:1.4rem;border-top:1px solid var(--border)">
                    <div style="font-size:0.9rem;color:var(--text-muted);margin-bottom:1rem">
                        <i class="fas fa-info-circle" style="margin-right:0.5rem"></i>
                        Your status helps store representatives know when you're available for new assignments.
                    </div>
                </div>
            </div>
        </div>

    </main>
</div>
