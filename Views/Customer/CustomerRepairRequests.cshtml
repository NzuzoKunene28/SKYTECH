@model IEnumerable<SkyTech.Models.Repair_Item_Services.Repair_Request>

@{
    ViewBag.Title = "My Repair Requests";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/DashboardStyle.css">
}

<div class="dash-wrap">

    <!-- ══ SIDEBAR ══ -->
    <aside class="dash-sidebar">
        <div class="dash-brand">
            <div class="dash-brand-icon"><i class="fas fa-user-circle"></i></div>
            <div>
                <div class="dash-brand-name">SkyTech</div>
                <div class="dash-brand-sub">Customer Portal</div>
            </div>
        </div>
        <nav class="dash-nav">
            <div class="dash-nav-label">MAIN</div>
            <a href="@Url.Action("CustomerDash", "Customer")" class="dash-link">
                <i class="fas fa-grid-2"></i><span>Dashboard</span>
            </a>

            <div class="dash-nav-label">SHOPPING</div>
            <a href="@Url.Action("ShoppingPage", "Customer")" class="dash-link">
                <i class="fas fa-shopping-bag"></i><span>Shop</span>
            </a>
            <a href="@Url.Action("MyOrders", "Customer")" class="dash-link">
                <i class="fas fa-bag-shopping"></i><span>My Orders</span>
            </a>
            <a href="@Url.Action("OrderHistory", "Customer")" class="dash-link">
                <i class="fas fa-history"></i><span>Order History</span>
            </a>

            <div class="dash-nav-label">REPAIRS</div>
            <a href="@Url.Action("CustomerRepairRequests", "Customer")" class="dash-link active">
                <i class="fas fa-tools"></i><span>My Repair Requests</span>
            </a>
            <a href="@Url.Action("Create", "Request_Repair_Service")" class="dash-link">
                <i class="fas fa-plus-circle"></i><span>New Repair Request</span>
            </a>

            <div class="dash-nav-label">ACCOUNT</div>
            <a href="@Url.Action("CustomerProfile", "Customer")" class="dash-link">
                <i class="fas fa-user"></i><span>Profile</span>
            </a>
            <a href="@Url.Action("MyReturns", "Customer")" class="dash-link">
                <i class="fas fa-undo"></i><span>Returns</span>
            </a>
        </nav>

        <div class="dash-sidebar-foot">
            <div class="dash-foot-avatar"><i class="fas fa-user"></i></div>
            <div>
                <div class="dash-foot-name">Customer</div>
                <div class="dash-foot-role">Customer</div>
            </div>
        </div>

        <div style="padding:.8rem 1.2rem;margin-top:1rem">
            @using (Html.BeginForm("Logout", "Authentication", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" style="width:100%;background:rgba(220,38,38,.08);border:1.5px solid rgba(220,38,38,.25);border-radius:8px;padding:.6rem 1rem;cursor:pointer;color:#dc2626;font-weight:600;font-size:.85rem;display:flex;align-items:center;gap:.5rem;justify-content:center">
                    <i class="fas fa-right-from-bracket"></i> Log Out
                </button>
            }
        </div>
    </aside>

    <!-- ══ MAIN CONTENT ══ -->
    <main class="dash-main">

        <!-- Top Bar -->
        <div class="dash-topbar">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <div>
                    <div class="dash-page-title">My Repair Requests</div>
                    <div class="dash-page-sub">Track and manage all your repair requests</div>
                </div>
                <a href="@Url.Action("Create", "Request_Repair_Service")" class="dash-btn dash-btn-primary">
                    <i class="fas fa-plus"></i> New Request
                </a>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="dash-grid dash-grid-2">
                @foreach (var request in Model)
                {
                    var statusBadgeClass = request.Status switch
                    {
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Pending => "dash-badge-warning",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Assigned => "dash-badge-info",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Qouted => "dash-badge-info",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.InProgress => "dash-badge-info",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Completed => "dash-badge-success",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Cancelled => "dash-badge-danger",
                        _ => "dash-badge-primary"
                    };

                    var statusIcon = request.Status switch
                    {
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Pending => "fas fa-hourglass-start",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Assigned => "fas fa-user-check",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Qouted => "fas fa-receipt",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.InProgress => "fas fa-wrench",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Completed => "fas fa-check-circle",
                        SkyTech.Models.Repair_Item_Services.RepairStatus.Cancelled => "fas fa-circle-xmark",
                        _ => "fas fa-question-circle"
                    };

                    <div class="dash-card">
                        <div class="dash-card-head">
                            <div>
                                <div class="dash-card-title">#@request.RequestId - @request.ItemName</div>
                                <div style="font-size:0.85rem;color:var(--text-muted);margin-top:0.3rem">
                                    <i class="fas fa-list" style="margin-right:0.3rem"></i>@request.Category?.CategoryName
                                </div>
                            </div>
                            <span class="dash-badge @statusBadgeClass">
                                <i class="@statusIcon" style="margin-right:0.3rem"></i>@request.Status.ToString()
                            </span>
                        </div>

                        <div style="padding:1rem;background:var(--blue-soft);border-radius:var(--radius-sm);margin-bottom:1rem;border:1px solid var(--border-lit)">
                            <div style="font-size:0.85rem;color:var(--text-muted);font-weight:500;margin-bottom:0.3rem">Issue Description</div>
                            <div style="font-size:0.95rem;color:var(--text);line-height:1.4">@request.IssueDescription</div>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;margin-bottom:1rem;font-size:0.9rem">
                            <div>
                                <div style="color:var(--text-muted);font-weight:500;margin-bottom:0.2rem">Item Description</div>
                                <div style="color:var(--text)">@request.ItemDescription</div>
                            </div>
                            <div>
                                <div style="color:var(--text-muted);font-weight:500;margin-bottom:0.2rem">Submitted On</div>
                                <div style="color:var(--text)">@request.DateCreated.ToString("dd MMM yyyy")</div>
                            </div>
                        </div>

                        <div style="display:flex;gap:0.6rem">
                            <a href="@Url.Action("ViewRepairDetail", "Customer", new { id = request.RequestId })" class="dash-btn dash-btn-primary" style="flex:1;justify-content:center">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                            @if (request.Status == SkyTech.Models.Repair_Item_Services.RepairStatus.Pending || request.Status == SkyTech.Models.Repair_Item_Services.RepairStatus.Assigned)
                            {
                                <a href="@Url.Action("Edit", "Request_Repair_Service", new { id = request.RequestId })" class="dash-btn dash-btn-secondary">
                                    <i class="fas fa-edit"></i>
                                </a>
                            }
                        </div>
                       
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dash-card" style="text-align:center;padding:3rem">
                <i class="fas fa-inbox" style="font-size:3rem;color:var(--text-muted);opacity:0.5;margin-bottom:1rem;display:block"></i>
                <p style="color:var(--text-muted);font-size:1.1rem;margin-bottom:1.5rem">No repair requests yet</p>
                <a href="@Url.Action("Create", "Request_Repair_Service")" class="dash-btn dash-btn-primary">
                    <i class="fas fa-plus"></i> Submit Your First Request
                </a>
            </div>
        }

    </main>
</div>
