@model SkyTech.Models.LeaseAgreement
@{
    ViewBag.Title = "Lease request submitted";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    double totalMonthly = Model.Items.Sum(i => i.MonthlyRateAtLease);
    double totalDeposit = Model.Items.Sum(i => i.DepositAtLease);
    double dueToday = totalMonthly + totalDeposit;
    var product = Model.Items.FirstOrDefault()?.LeaseUnit?.LeaseProduct;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShoppingPageStyle.css">
    <style>
        .conf-wrap { max-width: 560px; margin: 0 auto; padding: 2rem 1rem 100px; text-align: center; }
        .conf-icon { width: 64px; height: 64px; border-radius: 50%; background: #e3f6ec; color: #17845a; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin: 0 auto 1rem; }
        .conf-title { font-family: 'Clash Display', 'Plus Jakarta Sans', sans-serif; font-size: 1.4rem; font-weight: 600; color: #16344a; margin: 0 0 .4rem; }
        .conf-sub { color: #667085; font-size: .9rem; margin: 0 0 1.6rem; }
        .conf-card { background: #fff; border: 1px solid #e6ebf0; border-radius: 14px; padding: 1.2rem 1.3rem; text-align: left; margin-bottom: 1.2rem; }
        .conf-row { display: flex; justify-content: space-between; font-size: .88rem; padding: .4rem 0; color: #445; }
        .conf-row.total { border-top: 1px solid #e6ebf0; margin-top: .5rem; padding-top: .8rem; font-weight: 700; color: #16344a; }
        .conf-pay-btn { width: 100%; background: #cfd6dd; color: #667085; border: none; border-radius: 10px; padding: .9rem; font-weight: 600; font-size: .95rem; cursor: not-allowed; }
        .conf-note { font-size: .78rem; color: #8a94a6; margin-top: .6rem; }
    </style>
}

<div class="page-wrap">
    <header class="header">
        <a href="@Url.Action("ShoppingPage", "Customer")" class="logo"><span class="logo-l">S</span>kyTech</a>
    </header>

    <div class="conf-wrap">
        <div class="conf-icon"><i class="fas fa-check"></i></div>
        <div class="conf-title">Lease request submitted</div>
        <div class="conf-sub">Agreement #@Model.LeaseAgreementId is pending payment. We've reserved @Model.Items.Count unit(s) for you.</div>

        <div class="conf-card">
            <div class="conf-row"><span>Item</span><span>@(product?.LeaseProdName ?? "—")</span></div>
            <div class="conf-row"><span>Units reserved</span><span>@Model.Items.Count</span></div>
            <div class="conf-row"><span>Term</span><span>@Model.TermMonths months</span></div>
            <div class="conf-row"><span>Monthly rate</span><span>R @totalMonthly.ToString("N2")</span></div>
            <div class="conf-row"><span>Security deposit</span><span>R @totalDeposit.ToString("N2")</span></div>
            <div class="conf-row total"><span>Due today</span><span>R @dueToday.ToString("N2")</span></div>
        </div>

        <button class="conf-pay-btn" disabled><i class="fas fa-lock"></i> Proceed to payment</button>
        <div class="conf-note">Payment is being finalized — check back soon, or we'll notify you once it's ready.</div>
    </div>
</div>
