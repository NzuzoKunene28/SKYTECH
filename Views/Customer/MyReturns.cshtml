@model IEnumerable<SkyTech.Models.OrderItem>
@using SkyTech.Models
@{
    ViewBag.Title = "My Returns";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/CSS/MyOrdersStyle.css">
}

<header class="mo-header">
    <a href="@Url.Action("MyOrders", "Customer")" class="mo-back-btn" title="Back">&#8592;</a>
    <div>
        <div class="mo-header-title">My Returns</div>
        <div class="mo-header-sub">Track your return requests</div>
    </div>
</header>

<div class="mo-body">

    @if (Model == null || !Model.Any())
    {
        <div class="mo-empty">
            <div class="mo-empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-4.5" />
                </svg>
            </div>
            <div class="mo-empty-title">No returns yet</div>
            <div class="mo-empty-sub">Any items you return will appear here.</div>
            <a href="@Url.Action("MyOrders", "Customer")" class="mo-btn-primary">View Orders</a>
        </div>
    }
    else
    {
        <div class="mo-count">@Model.Count() return@(Model.Count() == 1 ? "" : "s")</div>

        foreach (var item in Model)
        {
            string statusClass, statusLabel;
            switch (item.ReturnPStatus)
            {
                case ReturnProduct.Return_Pending:
                    statusClass = "pending"; statusLabel = "Return Pending"; break;
                case ReturnProduct.Return_Approved:
                    statusClass = "assigned"; statusLabel = "Return Approved"; break;
                case ReturnProduct.Collection_Assigned:
                    statusClass = "out"; statusLabel = "Collection Assigned"; break;
                case ReturnProduct.Item_Collected:
                    statusClass = "out"; statusLabel = "Item Collected"; break;
                case ReturnProduct.Exchange_Dispatched:
                    statusClass = "out"; statusLabel = "Exchange Dispatched"; break;
                case ReturnProduct.Completed:
                    statusClass = "delivered"; statusLabel = "Completed"; break;
                default:
                    statusClass = "pending"; statusLabel = "Pending"; break;
            }

            <div class="mo-card">

                @* ── Card header ─────────────────────────── *@
                <div class="mo-card-header">
                    <div>
                        <div class="mo-order-id">#RET-@item.OrderItemId</div>
                        <div class="mo-order-date">Order #ORD-@item.OrderId</div>
                    </div>
                    <span class="mo-status-badge @statusClass">@statusLabel</span>
                </div>

                <div class="mo-divider"></div>

                @* ── Item info ───────────────────────────── *@
                <div class="mo-row">
                    <div class="mo-row-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                            <line x1="3" y1="6" x2="21" y2="6" />
                            <path d="M16 10a4 4 0 0 1-8 0" />
                        </svg>
                    </div>
                    <div>
                        <div class="mo-row-label">Item</div>
                        <div class="mo-row-value">@item.ProdName</div>
                        <div class="mo-row-sub">Qty returned: @item.QuantityReturned</div>
                    </div>
                </div>

                @* ── Return reason ───────────────────────── *@
                @if (!string.IsNullOrEmpty(item.RetunReason))
                {
                    <div class="mo-row">
                        <div class="mo-row-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10" />
                                <line x1="12" y1="8" x2="12" y2="12" />
                                <line x1="12" y1="16" x2="12.01" y2="16" />
                            </svg>
                        </div>
                        <div>
                            <div class="mo-row-label">Reason</div>
                            <div class="mo-row-value">@item.RetunReason</div>
                        </div>
                    </div>
                }

                @* ── Resolution ──────────────────────────── *@
                <div class="mo-row">
                    <div class="mo-row-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="1 4 1 10 7 10" />
                            <path d="M3.51 15a9 9 0 1 0 .49-4.5" />
                        </svg>
                    </div>
                    <div>
                        <div class="mo-row-label">Resolution</div>
                        <div class="mo-row-value">
                            @(item.RefundOrExchange == GetRefund.Refund ? "Refund" :
                              item.RefundOrExchange == GetRefund.Exchange_item ? "Exchange Item" : "N/A")
                        </div>
                    </div>
                </div>

                @* ── Collection date ─────────────────────── *@
                @if (item.CollectionDate != null)
                {
                    <div class="mo-row">
                        <div class="mo-row-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                            </svg>
                        </div>
                        <div>
                            <div class="mo-row-label">Scheduled Collection</div>
                            <div class="mo-row-value">
                                @item.CollectionDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                }

                @* ── New delivery date ───────────────────────────── *@
                @if (item.NewDeliveryDate != null)
                {
                    <div class="mo-row">
                        <div class="mo-row-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                                <line x1="16" y1="2" x2="16" y2="6" />
                                <line x1="8" y1="2" x2="8" y2="6" />
                                <line x1="3" y1="10" x2="21" y2="10" />
                                <polyline points="9 14 11 16 15 12" />
                            </svg>
                        </div>
                        <div>
                            <div class="mo-row-label">Estimated Exchange Delivery</div>
                            <div class="mo-row-value">
                                @item.NewDeliveryDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            </div>
                        </div>
                    </div>
                }

                @* ── Driver ──────────────────────────────── *@
                @if (item.DeliveryDriver != null)
                {
                    string initials = "";
                    if (!string.IsNullOrEmpty(item.DeliveryDriver.DriverName)) initials += item.DeliveryDriver.DriverName[0];
                    if (!string.IsNullOrEmpty(item.DeliveryDriver.DriverSurname)) initials += item.DeliveryDriver.DriverSurname[0];

                    <div class="mo-row">
                        <div class="mo-driver-avatar-sm">@initials.ToUpper()</div>
                        <div>
                            <div class="mo-row-label">Collection Driver</div>
                            <div class="mo-row-value">
                                @(item.DeliveryDriver.DriverName ?? "") @(item.DeliveryDriver.DriverSurname ?? "")
                            </div>
                            <div class="mo-row-sub">@(item.DeliveryDriver.VehicleNumber ?? "N/A")</div>
                        </div>
                    </div>
                }

                <div class="mo-divider"></div>

                @* ── Footer ──────────────────────────────── *@
                <div class="mo-card-footer">
                    <div>
                        <div class="mo-total-label">Item Value</div>
                        <div class="mo-total-value">R @item.PriceAtTimeOfPurchase.ToString("0.00")</div>
                    </div>
                    <a href="@Url.Action("TrackReturn", "Customer", new { id = item.OrderItemId })"
                           class="mo-track-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M12 5l7 7-7 7" />
                        </svg>
                        Track
                    </a>
                </div>

            </div>
        }
    }

</div>