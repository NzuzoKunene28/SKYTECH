@model IEnumerable<SkyTech.Models.AddProduct>
@using SkyTech.Models
@{
    ViewBag.Title = "SkyTech • Shop";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/CSS/ShoppingPageStyle.css">
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SkyTech • Shopping</title>
</head>
<body>

    <div class="page-wrap">

        <!-- ══ HEADER ══ -->
        <header class="header">
            <a href="#" class="logo">
                <span class="logo-l">S</span>kyTech
            </a>

            <div class="search-bar">
                <form method="get" action="@Url.Action("ShoppingPage", "Customer")">
                    <button type="submit" class="fas fa-search search-icon"></button>
                    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search products, brands…" aria-label="Search">
                </form>
            </div>

            <a href="@Url.Action("ViewCart", "Customer")" class="cart-btn" aria-label="Cart">
                <i class="fas fa-bag-shopping"></i>
                <span class="cart-count" id="cartCount">@ViewBag.NumberOfCartItems</span>
            </a>
        </header>

        <!-- CATEGORIES strip -->
        <div class="cat-strip-wrap">
            <div class="cat-strip">
                <a href="@Url.Action("ShoppingPage", "Customer")" class="cat-pill @(ViewBag.SelectedCategory == null ? "active" : "")">
                    <i class="fas fa-border-all"></i> All
                </a>
                @foreach (SelectCategory cat in Enum.GetValues(typeof(SelectCategory)))
                {
                    <a href="@Url.Action("ShoppingPage", "Customer", new { category = cat })" class="cat-pill @(ViewBag.SelectedCategory != null && ViewBag.SelectedCategory.Equals(cat) ? "active" : "")">
                        @cat
                    </a>
                }
            </div>
        </div>

        <!-- ══ HERO ══ -->
        <section class="hero">
            <div class="hero-inner">
                <div class="hero-tag"><i class="fas fa-bolt"></i> Start Shopping Today</div>
                <h1 class="hero-title">Daily<br /><span>Deals</span></h1>
                <p class="hero-sub">Up to 10% off · for products over R500</p>
            </div>
            <div class="hero-art">
                <div class="hero-circle c1"></div>
                <div class="hero-circle c2"></div>
                <div class="hero-circle c3"></div>
                <div class="hero-discount">
                    <span class="disc-num">10</span>
                    <span class="disc-pct">%<br />OFF</span>
                </div>
            </div>
        </section>

        <!-- ========== FLASH DEALS (Main product list) ========== -->
        <div class="section-hdr">
            <div class="section-hdr-left">
                <span class="section-icon"><i class="fas fa-bolt"></i></span>
                <span class="section-title">Flash Deals</span>
            </div>
            <span class="section-tag">@Model.Count() items</span>
        </div>

        @if (!Model.Any())
        {
            <div class="cart-empty" style="margin: 2rem 0;">
                <i class="fas fa-search"></i>
                <h2>No products found</h2>
                <p>Try a different search term or browse all categories.</p>
                <a href="@Url.Action("ShoppingPage", "Customer")" class="btn-shop">
                    <i class="fas fa-arrow-left"></i> View all products
                </a>
            </div>
        }
        else
        {
            <div class="product-grid">
                @{
                    int cardIdx = 0;
                }
                @foreach (var item in Model)
                {
                    bool inStock = item.ProdQuantity > 0;
                    <div class="p-card" style="animation-delay:@(cardIdx * 60)ms">
                        <div class="p-img-wrap">
                            @if (item.ProductPictures != null && item.ProductPictures.Any())
                            {
                                var pic = item.ProductPictures.First();
                                <a href="@Url.Action("ProductDetails", "Customer", new { id = item.ProdId })">
                                    <img src="@pic.FilePath" alt="@pic.FileName" class="p-img" />
                                </a>
                            }
                            else
                            {
                                <div class="p-img-placeholder"><i class="fas fa-image"></i></div>
                            }
                            @if (!inStock)
                            {
                                <div class="p-oos-badge">Out of stock</div>
                            }
                            <div class="p-img-shine"></div>
                        </div>

                        <div class="p-body">
                            <div class="p-name">@item.ProdName</div>
                            <div class="p-meta-row">
                                <div class="p-price">R&nbsp;@item.ProdPrice</div>
                                @if (inStock)
                                {
                                    <div class="p-stock-chip">@item.ProdQuantity left</div>
                                }
                            </div>

                            @if (inStock)
                            {
                                <form class="add-form" data-product-id="@item.ProdId" onsubmit="addToCart(event, this)">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProdId" />
                                    <div class="add-row">
                                        <div class="qty-stepper">
                                            <button type="button" class="qty-btn" onclick="stepQty(this,-1)">−</button>
                                            <input type="number" name="quantity" value="1" min="1" max="@item.ProdQuantity" class="qty-input" />
                                            <button type="button" class="qty-btn" onclick="stepQty(this,1)" data-max="@item.ProdQuantity">+</button>
                                        </div>
                                        <button type="submit" class="add-btn">
                                            <i class="fas fa-bag-shopping"></i> Add
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="add-row">
                                    <button class="add-btn oos" disabled>Notify me</button>
                                </div>
                            }
                        </div>
                    </div>
                    cardIdx++;
                }
            </div>
        }

        <!-- ══ BANNER ══ -->
        <div class="scan-banner">
            <div class="scan-banner-left">
                <div>
                    <div class="scan-banner-sub">Trusted Tech & Appliances — Affordable for You</div>
                </div>
            </div>
        </div>

        <!-- ========== POPULAR PICKS ========== -->
        <div class="section-hdr">
            <div class="section-hdr-left">
                <span class="section-icon fire"><i class="fas fa-fire"></i></span>
                <span class="section-title">Popular Picks</span>
            </div>
        </div>

        @if (ViewBag.PopularPicks == null || !((IEnumerable<SkyTech.Models.AddProduct>)ViewBag.PopularPicks).Any())
        {
            <div class="cart-empty" style="margin: 1rem 0 2rem;">
                <i class="fas fa-fire"></i>
                <h3>No popular picks yet</h3>
                <p>Check back soon for trending items.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @{
                    int cardIdx = 0;
                }
                @foreach (SkyTech.Models.AddProduct item in ViewBag.PopularPicks)
                {
                    bool inStock = item.ProdQuantity > 0;
                    <div class="p-card" style="animation-delay:@(cardIdx * 60)ms">
                        <div class="p-img-wrap">
                            @if (item.ProductPictures != null && item.ProductPictures.Any())
                            {
                                var pic = item.ProductPictures.First();
                                <a href="@Url.Action("ProductDetails", "Customer", new { id = item.ProdId })">
                                    <img src="@pic.FilePath" alt="@pic.FileName" class="p-img" />
                                </a>
                            }
                            else
                            {
                                <div class="p-img-placeholder"><i class="fas fa-image"></i></div>
                            }
                            @if (!inStock)
                            {
                                <div class="p-oos-badge">Out of stock</div>
                            }
                            <div class="p-img-shine"></div>
                        </div>

                        <div class="p-body">
                            <div class="p-name">@item.ProdName</div>
                            <div class="p-meta-row">
                                <div class="p-price">R @item.ProdPrice</div>
                                @if (inStock)
                                {
                                    <div class="p-stock-chip">@item.ProdQuantity left</div>
                                }
                            </div>

                            @if (inStock)
                            {
                                <form class="add-form" data-product-id="@item.ProdId" onsubmit="addToCart(event, this)">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProdId" />
                                    <div class="add-row">
                                        <div class="qty-stepper">
                                            <button type="button" class="qty-btn" onclick="stepQty(this,-1)">−</button>
                                            <input type="number" name="quantity" value="1" min="1" max="@item.ProdQuantity" class="qty-input" />
                                            <button type="button" class="qty-btn" onclick="stepQty(this,1)" data-max="@item.ProdQuantity">+</button>
                                        </div>
                                        <button type="submit" class="add-btn">
                                            <i class="fas fa-bag-shopping"></i> Add
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="add-row">
                                    <button class="add-btn oos" disabled>Notify me</button>
                                </div>
                            }
                        </div>
                    </div>
                    cardIdx++;
                }
            </div>
        }

        <!-- ══ BANNER ══ -->
        <div class="scan-banner">
            <div class="scan-banner-left">
                <div>
                    <div class="scan-banner-sub">Trusted Tech & Appliances — Affordable for You</div>
                </div>
            </div>
        </div>

        <!-- ========== APPLIANCES ========== -->
        <div class="section-hdr">
            <div class="section-hdr-left">
                <span class="section-icon fire"><i class="fas fa-fire"></i></span>
                <span class="section-title">Appliances</span>
            </div>
        </div>

        @if (ViewBag.Groceries == null || !((IEnumerable<SkyTech.Models.AddProduct>)ViewBag.Groceries).Any())
        {
            <div class="cart-empty" style="margin: 1rem 0 2rem;">
                <i class="fas fa-blender-phone"></i>
                <h3>No appliances available</h3>
                <p>Check back later for new arrivals.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @{
                    int cardIdx = 0;
                }
                @foreach (SkyTech.Models.AddProduct item in ViewBag.Groceries)
                {
                    bool inStock = item.ProdQuantity > 0;
                    <div class="p-card" style="animation-delay:@(cardIdx * 60)ms">
                        <div class="p-img-wrap">
                            @if (item.ProductPictures != null && item.ProductPictures.Any())
                            {
                                var pic = item.ProductPictures.First();
                                <a href="@Url.Action("ProductDetails", "Customer", new { id = item.ProdId })">
                                    <img src="@pic.FilePath" alt="@pic.FileName" class="p-img" />
                                </a>
                            }
                            else
                            {
                                <div class="p-img-placeholder"><i class="fas fa-image"></i></div>
                            }
                            @if (!inStock)
                            {
                                <div class="p-oos-badge">Out of stock</div>
                            }
                            <div class="p-img-shine"></div>
                        </div>

                        <div class="p-body">
                            <div class="p-name">@item.ProdName</div>
                            <div class="p-meta-row">
                                <div class="p-price">R @item.ProdPrice</div>
                                @if (inStock)
                                {
                                    <div class="p-stock-chip">@item.ProdQuantity left</div>
                                }
                            </div>

                            @if (inStock)
                            {
                                <form class="add-form" data-product-id="@item.ProdId" onsubmit="addToCart(event, this)">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.ProdId" />
                                    <div class="add-row">
                                        <div class="qty-stepper">
                                            <button type="button" class="qty-btn" onclick="stepQty(this,-1)">−</button>
                                            <input type="number" name="quantity" value="1" min="1" max="@item.ProdQuantity" class="qty-input" />
                                            <button type="button" class="qty-btn" onclick="stepQty(this,1)" data-max="@item.ProdQuantity">+</button>
                                        </div>
                                        <button type="submit" class="add-btn">
                                            <i class="fas fa-bag-shopping"></i> Add
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="add-row">
                                    <button class="add-btn oos" disabled>Notify me</button>
                                </div>
                            }
                        </div>
                    </div>
                    cardIdx++;
                }
            </div>
        }

        <div style="height:90px"></div>
    </div>

    <!-- ══ BOTTOM NAV ══ -->
    <nav class="bottom-nav">
        <a href="@Url.Action("ShoppingPage", "Customer")" class="bn-item active">
            <div class="bn-icon"><i class="fas fa-house"></i></div>
            <span>Home</span>
        </a>
        <a href="@Url.Action("WishList", "Customer")" class="bn-item">
            <div class="bn-icon"><i class="far fa-heart"></i></div>
            <span>Wishlist</span>
        </a>
        <a href="@Url.Action("ViewCart", "Customer")" class="bn-item">
            <div class="bn-icon cart-nav-wrap">
                <i class="fas fa-bag-shopping"></i>
                <span class="bn-badge">@ViewBag.NumberOfCartItems</span>
            </div>
            <span>Cart</span>
        </a>
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <a href="@Url.Action("CustomerProfile", "Customer")" class="bn-item">
                <div class="bn-icon"><i class="far fa-user-circle"></i></div>
                <span>Account</span>
            </a>
        }
        else
        {
            <a href="@Url.Action("LogIn", "Authentication")" class="bn-item">
                <div class="bn-icon"><i class="far fa-user-circle"></i></div>
                <span>Account</span>
            </a>
        }
    </nav>

    <script>
            // Quantity stepper
            function stepQty(btn, dir) {
                const row = btn.closest('.qty-stepper');
                const input = row.querySelector('.qty-input');
                const max = parseInt(row.querySelector('[data-max]')?.dataset.max) || 99;
                input.value = Math.max(1, Math.min(max, (parseInt(input.value) || 1) + dir));
            }

            // AJAX Add to Cart (prevents page reload and scroll jump)
            async function addToCart(event, form) {
                event.preventDefault();

                const btn = form.querySelector('.add-btn');
                const originalHtml = btn.innerHTML;
                const originalBg = btn.style.background;
                const originalShadow = btn.style.boxShadow;

                // Disable button and show loading
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';

                const formData = new FormData(form);
                const url = '@Url.Action("AddToCart", "Customer")';

                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        // Success feedback
                        btn.innerHTML = '<i class="fas fa-check"></i> Added!';
                        btn.style.background = '#16a34a';
                        btn.style.boxShadow = '0 4px 14px rgba(22,163,74,0.3)';

                        // Update cart count in header and bottom nav
                        try {
                            const countResponse = await fetch('@Url.Action("GetCartCount", "Customer")');
                            const newCount = await countResponse.json();
                            document.querySelectorAll('#cartCount, .bn-badge, .cart-count').forEach(el => {
                                if (el) el.textContent = newCount;
                            });
                        } catch (e) {
                            console.warn('Could not update cart count', e);
                        }

                        // Reset after 1.8 seconds
                        setTimeout(() => {
                            btn.innerHTML = originalHtml;
                            btn.style.background = originalBg;
                            btn.style.boxShadow = originalShadow;
                            btn.disabled = false;
                        }, 1800);
                    } else {
                        throw new Error('Failed to add item');
                    }
                } catch (error) {
                    console.error('Add to cart error:', error);
                    btn.innerHTML = originalHtml;
                    btn.style.background = originalBg;
                    btn.style.boxShadow = originalShadow;
                    btn.disabled = false;
                    alert('Could not add to cart. Please try again.');
                }
            }

            // Staggered card entrance animation
            document.querySelectorAll('.p-card').forEach(c => {
                c.style.opacity = '0';
                c.style.transform = 'translateY(20px)';
            });
            window.addEventListener('load', () => {
                document.querySelectorAll('.p-card').forEach((c, i) => {
                    setTimeout(() => {
                        c.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                        c.style.opacity = '1';
                        c.style.transform = 'translateY(0)';
                    }, 60 + i * 55);
                });
            });
    </script>
</body>
</html>