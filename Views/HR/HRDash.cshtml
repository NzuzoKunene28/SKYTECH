@{
    ViewData["Title"] = "HR Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
    :root {
        --primary: #16888b;
        --primary-dark: #106c70;
        --primary-light: #e9f8f8;
        --navy: #15233d;
        --text: #354158;
        --muted: #748199;
        --border: #dfe7ef;
        --background: #f4f7fa;
        --white: #ffffff;
        --shadow: 0 14px 40px rgba(25, 50, 80, .08);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        color: var(--text);
        font-family: "Inter", sans-serif;
        background: radial-gradient( circle at top left, rgba(22, 136, 139, .09), transparent 27rem ), var(--background);
    }

    .hr-dashboard {
        width: min(1180px, calc(100% - 32px));
        margin: 35px auto 60px;
    }

    /* Header matching Generate Roster */
    .dashboard-header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        min-height: 200px;
        padding: 34px;
        margin-bottom: 28px;
        overflow: hidden;
        color: white;
        background: linear-gradient(135deg, #126f73, #23989a);
        border-radius: 24px;
        box-shadow: 0 18px 45px rgba(18, 111, 115, .22);
    }

        .dashboard-header::before,
        .dashboard-header::after {
            position: absolute;
            content: "";
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 50%;
        }

        .dashboard-header::before {
            width: 270px;
            height: 270px;
            top: -165px;
            right: -70px;
        }

        .dashboard-header::after {
            width: 180px;
            height: 180px;
            right: 95px;
            bottom: -140px;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .header-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        margin-bottom: 14px;
        color: white;
        background: rgba(255, 255, 255, .13);
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .dashboard-header h1 {
        margin: 0 0 9px;
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 800;
        letter-spacing: -.04em;
    }

    .dashboard-header p {
        max-width: 670px;
        margin: 0;
        color: rgba(255, 255, 255, .82);
        font-size: 14px;
        line-height: 1.7;
    }

    .header-icon {
        position: relative;
        z-index: 2;
        display: grid;
        width: 84px;
        min-width: 84px;
        height: 84px;
        color: white;
        background: rgba(255, 255, 255, .14);
        border: 1px solid rgba(255, 255, 255, .2);
        border-radius: 22px;
        font-size: 33px;
        backdrop-filter: blur(8px);
        place-items: center;
    }

    /* Dashboard sections */
    .dashboard-section {
        padding: 28px 30px;
        margin-bottom: 22px;
        background: var(--white);
        border: 1px solid rgba(220, 229, 238, .9);
        border-radius: 22px;
        box-shadow: var(--shadow);
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 21px;
    }

    .section-number {
        display: grid;
        width: 42px;
        min-width: 42px;
        height: 42px;
        color: var(--primary);
        background: var(--primary-light);
        border-radius: 12px;
        font-weight: 800;
        place-items: center;
    }

    .section-heading-text h2,
    .section-title {
        margin: 0;
        color: var(--navy);
        font-size: 18px;
        font-weight: 800;
    }

    .section-heading-text p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 12px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 15px;
    }

    .dashboard-card {
        position: relative;
        display: flex;
        min-height: 155px;
        padding: 20px;
        overflow: hidden;
        color: var(--text);
        text-decoration: none;
        background: #fbfcfe;
        border: 1.5px solid var(--border);
        border-radius: 16px;
        box-shadow: none;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .dashboard-card::before {
            display: none;
        }

        .dashboard-card::after {
            position: absolute;
            right: -34px;
            bottom: -34px;
            width: 85px;
            height: 85px;
            content: "";
            background: var(--primary-light);
            border-radius: 50%;
            transition: .25s ease;
        }

        .dashboard-card:hover {
            color: var(--text);
            text-decoration: none;
            background: white;
            border-color: rgba(22, 136, 139, .5);
            box-shadow: 0 12px 28px rgba(25, 58, 86, .1);
            transform: translateY(-3px);
        }

            .dashboard-card:hover::after {
                width: 120px;
                height: 120px;
            }

        .dashboard-card:focus {
            outline: 3px solid rgba(22, 136, 139, .18);
            outline-offset: 2px;
        }

    .card-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .card-icon {
        display: grid;
        width: 47px;
        min-width: 47px;
        height: 47px;
        margin-bottom: 15px;
        color: var(--primary);
        background: var(--primary-light);
        border-radius: 13px;
        font-size: 19px;
        place-items: center;
    }

    .card-title {
        margin-bottom: 6px;
        padding-right: 20px;
        color: var(--navy);
        font-size: 14px;
        font-weight: 800;
    }

    .card-description {
        margin: 0;
        padding-right: 14px;
        color: var(--muted);
        font-size: 11px;
        line-height: 1.6;
    }

    .card-arrow {
        position: absolute;
        z-index: 3;
        right: 18px;
        bottom: 16px;
        display: grid;
        width: 28px;
        height: 28px;
        color: var(--primary);
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 18px;
        font-weight: 700;
        transition: .2s ease;
        place-items: center;
    }

    .dashboard-card:hover .card-arrow {
        color: white;
        background: var(--primary);
        border-color: var(--primary);
        transform: translateX(3px);
    }

    @@media (max-width: 950px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .hr-dashboard {
            width: min(100% - 20px, 1180px);
            margin-top: 18px;
        }

        .dashboard-header {
            min-height: auto;
            padding: 28px 23px;
        }

        .header-icon {
            display: none;
        }

        .dashboard-section {
            padding: 23px 20px;
            border-radius: 18px;
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<main class="hr-dashboard">
    <header class="dashboard-header">
        <h1>HR Dashboard</h1>

        <p>
            Manage recruitment, employees, branches, rosters, shift changes
            and leave requests from one place.
        </p>
    </header>

    <!-- Recruitment -->
    <section class="dashboard-section">
        <h2 class="section-title">Recruitment</h2>

        <div class="dashboard-grid">
            <a class="dashboard-card"
               href="@Url.Action("JobApplications", "HR")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-file-lines"></i>
                    </span>

                    <span class="card-title">
                        Review Applications
                    </span>

                    <p class="card-description">
                        Review and manage submitted job applications.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("JobCenter", "HR")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-briefcase"></i>
                    </span>

                    <span class="card-title">Job Center</span>

                    <p class="card-description">
                        Manage vacancies and recruitment activities.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("PendingInterviews", "Recruitment")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </span>

                    <span class="card-title">
                        Pending Interviews
                    </span>

                    <p class="card-description">
                        Review candidates awaiting interview scheduling.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("ScheduledInterviews", "Recruitment")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-calendar-check"></i>
                    </span>

                    <span class="card-title">
                        Scheduled Interviews
                    </span>

                    <p class="card-description">
                        View upcoming candidate interviews.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>
        </div>
    </section>

    <!-- Staff, Branches and Rosters -->
    <section class="dashboard-section">
        <h2 class="section-title">
            Staff, Branches and Rosters
        </h2>

        <div class="dashboard-grid">
            <a class="dashboard-card"
               href="@Url.Action("GenerateWeekly", "Roster")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </span>

                    <span class="card-title">
                        Generate Weekly Roster
                    </span>

                    <p class="card-description">
                        Create weekly staff schedules and assignments.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("RosterList", "Roster")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-list-check"></i>
                    </span>

                    <span class="card-title">
                        View All Rosters
                    </span>

                    <p class="card-description">
                        Open current, previous and upcoming staff rosters.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("StaffDirectory", "HR")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-users"></i>
                    </span>

                    <span class="card-title">
                        Staff Directory
                    </span>

                    <p class="card-description">
                        View employee information, positions and departments.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("Branches", "HR")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-store"></i>
                    </span>

                    <span class="card-title">
                        Manage Branches
                    </span>

                    <p class="card-description">
                        View branches and register new business locations.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>
        </div>
    </section>

    <!-- Employee Requests -->
    <section class="dashboard-section">
        <h2 class="section-title">Employee Requests</h2>

        <div class="dashboard-grid">
            <a class="dashboard-card"
               href="@Url.Action("PendingRequests", "ShiftChange")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-right-left"></i>
                    </span>

                    <span class="card-title">
                        Shift Change Requests
                    </span>

                    <p class="card-description">
                        Review and process requested shift changes.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>

            <a class="dashboard-card"
               href="@Url.Action("PendingRequests", "LeaveAssessment")">

                <div class="card-content">
                    <span class="card-icon" aria-hidden="true">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </span>

                    <span class="card-title">
                        Assess Leave Requests
                    </span>

                    <p class="card-description">
                        Assess pending employee leave applications.
                    </p>
                </div>

                <span class="card-arrow" aria-hidden="true">›</span>
            </a>
        </div>
    </section>
</main>
