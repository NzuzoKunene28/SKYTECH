                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 8V6a2 2 0 0 1 2-2h2M4 16v2a2 2 0 0 0 2 2h2M20 8V6a2 2 0 0 0-2-2h-2M20 16v2a2 2 0 0 1-2 2h-2" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                Enroll My Face
            </a>

            <a class="staff-link" href="@Url.Action("MyRequests", "ShiftChange")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 2.1 21 6l-4 4M3 12v-2a4 4 0 0 1 4-4h14M7 21.9 3 18l4-4M21 12v2a4 4 0 0 1-4 4H3" />
                </svg>
                My Requests
            </a>
        </div>
    </nav>

    <main class="staff-main">
        <p class="staff-eyebrow">Dashboard</p>
        <h1 class="staff-title">Welcome back</h1>
        <p class="staff-sub">Here's your shift status for today.</p>

        <div class="shift-card">
            <h3>Today's Shift</h3>
            @if (!(bool)ViewBag.HasShiftToday)
            {
                <p>No shift scheduled for today.</p>
            }
            else if ((bool)ViewBag.IsCheckedIn)
            {
                <p>Checked in at <strong>@(((DateTime)ViewBag.TodayCheckInTime).ToString("HH:mm"))</strong></p>
            }
            else if (ViewBag.TodayCheckOutTime != null)
            {
                <p>Shift completed — checked out at <strong>@(((DateTime)ViewBag.TodayCheckOutTime).ToString("HH:mm"))</strong></p>
            }
            else
            {
                <p>Not checked in yet today.</p>
            }
            <p class="shift-meta">@ViewBag.DaysAttendedThisWeek day(s) attended this week &middot; @(((double)ViewBag.HoursThisWeek).ToString("0.0")) hours logged</p>
        </div>
    </main>
</div>


