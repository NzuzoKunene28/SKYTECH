@model SkyTech.Models.ViewModels.AssessmentViewModel

@{
    ViewData["Title"] = "Fraud Signals";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
}

<style>
    :root {
        --blue: #5f9ea0;
        --blue-dark: #2d6b6d;
        --blue-deep: #1f4f50;
        --bg: #f0f4fc;
        --border: #dde6f5;
        --text: #0e1b35;
        --text-2: #4a5878;
        --text-m: #8a96b0;
        --red: #dc2626;
    }

    .assess-page {
        min-height: 80vh;
        background: var(--bg);
        padding: 45px 20px;
    }

    .assess-container {
        max-width: 900px;
        margin: auto;
    }

    .step-label {
        color: var(--blue-dark);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-title {
        color: var(--text);
        font-size: 34px;
        font-weight: 750;
        margin: 7px 0;
    }

    .page-subtitle {
        color: var(--text-2);
        margin-bottom: 30px;
    }

    .result-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 12px 35px rgba(31, 79, 80, 0.07);
    }

    .flag-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        padding: 18px 0;
        border-bottom: 1px solid var(--border);
    }

        .flag-row:last-child {
            border-bottom: none;
        }

    .flag-text {
        color: var(--text-2);
        font-size: 14px;
        flex: 1;
    }

    .flag-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .severity-critical {
        background: #fde8e8;
        color: var(--red);
    }

    .severity-warning {
        background: #fff4d6;
        color: #8a6100;
    }

    .severity-info {
        background: #f1f4f8;
        color: var(--text-2);
    }

    .dismiss-button {
        border: 1px solid var(--border);
        background: white;
        color: var(--text-2);
        padding: 8px 14px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

    .no-flags {
        color: var(--text-m);
        font-size: 14px;
    }

    .continue-btn {
        display: inline-block;
        background: var(--blue-dark);
        color: white;
        border: none;
        padding: 13px 24px;
        border-radius: 11px;
        font-weight: 600;
        text-decoration: none;
        margin-top: 25px;
    }

        .continue-btn:hover {
            background: var(--blue-deep);
            color: white;
        }

    .back-btn {
        display: inline-block;
        background: white;
        color: var(--text-2);
        border: 1px solid var(--border);
        padding: 13px 24px;
        border-radius: 11px;
        font-weight: 600;
        text-decoration: none;
        margin-top: 25px;
        margin-right: 10px;
    }

    .items-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
        margin-top: 10px;
    }

    .collateral-card {
        background: #fbfcff;
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
    }

    .collateral-image {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background: white;
        padding: 10px;
    }

    .collateral-body {
        padding: 20px;
    }

    .collateral-name {
        color: var(--text);
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dup-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .dup-yes {
        background: #fde8e8;
        color: var(--red);
    }

    .dup-no {
        background: #e1f4e9;
        color: #177245;
    }

    .match-row {
        border-top: 1px solid var(--border);
        padding: 10px 0;
        font-size: 13px;
        color: var(--text-2);
    }

        .match-row strong {
            color: var(--text);
        }

    /* ── Dismiss reason modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(14, 27, 53, 0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 22px;
        padding: 35px;
        max-width: 440px;
        width: 100%;
        box-shadow: 0 25px 60px rgba(31, 79, 80, 0.25);
        text-align: left;
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f1f4f8;
        color: var(--text-2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
    }

    .modal-title {
        color: var(--text);
        font-size: 20px;
        font-weight: 750;
        margin-bottom: 8px;
        text-align: center;
    }

    .modal-text {
        color: var(--text-2);
        font-size: 14px;
        margin-bottom: 18px;
        line-height: 1.5;
        text-align: center;
    }

    .modal-field-label {
        display: block;
        color: var(--text);
        font-weight: 650;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .modal-textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        font-family: inherit;
        font-size: 14px;
        min-height: 80px;
        box-sizing: border-box;
        resize: vertical;
        margin-bottom: 8px;
    }

        .modal-textarea:focus {
            outline: none;
            border-color: var(--blue);
            box-shadow: 0 0 0 3px rgba(95, 158, 160, 0.14);
        }

    .modal-error {
        color: var(--red);
        font-size: 12px;
        margin-bottom: 10px;
        display: none;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 10px;
    }

    .modal-btn {
        flex: 1;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-weight: 650;
        cursor: pointer;
        font-size: 14px;
    }

    .modal-btn-cancel {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-2);
    }

    .modal-btn-confirm {
        background: var(--blue-dark);
        color: white;
    }

</style>

<div class="assess-page">
    <div class="assess-container">

        <div class="step-label">Step 2 of 3</div>
        <h1 class="page-title">Fraud Signals</h1>
        <p class="page-subtitle">
            Application #@Model.LoanApplication.LoanApplicationId — automated checks against this applicant and their collateral.
        </p>

        <div class="result-card">

            @if (!Model.FraudFlags.Any())
            {
                <div class="no-flags">No fraud signals were detected for this application.</div>
            }
            else
            {
                @foreach (var flag in Model.FraudFlags)
                {
                    var severityClass = flag.Severity switch
                    {
                        SkyTech.Models.SkytechWorkers.FraudFlagSeverity.Critical => "severity-critical",
                        SkyTech.Models.SkytechWorkers.FraudFlagSeverity.Warning => "severity-warning",
                        _ => "severity-info"
                    };

                    <div class="flag-row" data-flag-id="@flag.FraudFlagId">

                        <div class="flag-text">
                            <span class="flag-badge @severityClass">@flag.Type</span>
                            <div>@flag.Details</div>
                            @if (flag.Dismissed)
                            {
                                <div style="color: var(--text-m); font-size: 12px; margin-top: 4px;">
                                    Dismissed: @flag.DismissReason
                                </div>
                            }
                        </div>

                        @if (!flag.Dismissed)
                        {
                            <button type="button" class="dismiss-button dismiss-flag-btn">Dismiss</button>
                        }

                    </div>
                }
            }

            @if (Model.AnyUnresolvedCriticalFlags)
            {
                <p style="color: var(--red); margin-top: 20px;">
                    There are unresolved critical fraud flags. You can continue, but these will block approval
                    at the final decision step until dismissed with a reason.
                </p>
            }

            <div class="result-card">

                <div class="section-title" style="color: var(--text); font-size: 19px; font-weight: 700; margin-bottom: 18px;">
                    Collateral Image Duplicate Check
                </div>

                <div class="items-grid">

                    @foreach (var check in Model.CollateralImageChecks)
                    {
                        <div class="collateral-card">

                            <img src="@check.ImagePath" class="collateral-image" alt="@check.Description" />

                            <div class="collateral-body">

                                <div class="collateral-name">@check.Description</div>

                                @if (check.IsDuplicate)
                                {
                                    <span class="dup-badge dup-yes">Duplicate found — used before</span>

                                    @foreach (var match in check.Matches)
                                    {
                                        <div class="match-row">
                                            Also used on <strong>Application #@match.MatchedLoanApplicationId</strong>
                                            ("@match.MatchedDescription"), uploaded
                                            <strong>@match.MatchedUploadedOn.ToString("dd MMM yyyy HH:mm")</strong>
                                            — that application's status is <strong>@match.MatchedApplicationStatus</strong>.
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="dup-badge dup-no">New — never used before</span>
                                }

                            </div>

                        </div>
                    }

                </div>

            </div>


            <a asp-action="CreditRecheck" asp-route-id="@Model.LoanAssessmentId" class="back-btn">← Back</a>
            <a asp-action="Decision" asp-route-id="@Model.LoanAssessmentId" class="continue-btn">
                Continue to Decision →
            </a>

        </div>

    </div>
</div>

<!-- Dismiss reason modal -->
<div class="modal-overlay" id="dismissModal">

    <div class="modal-box">

        <div class="modal-icon">!</div>

        <div class="modal-title">Dismiss this fraud flag?</div>

        <p class="modal-text">
            Please give a short reason. This will be kept on record for audit purposes.
        </p>

        <label class="modal-field-label" for="dismissReasonInput">Reason</label>
        <textarea id="dismissReasonInput" class="modal-textarea" placeholder="e.g. Verified manually, not a genuine match"></textarea>
        <div class="modal-error" id="dismissError">A reason is required to dismiss this flag.</div>

        <div class="modal-actions">
            <button type="button" class="modal-btn modal-btn-cancel" id="dismissCancelBtn">Cancel</button>
            <button type="button" class="modal-btn modal-btn-confirm" id="dismissConfirmBtn">Dismiss Flag</button>
        </div>

    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        function getAntiForgeryToken() {
            const input = document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : "";
        }

        const dismissModal = document.getElementById("dismissModal");
        const dismissReasonInput = document.getElementById("dismissReasonInput");
        const dismissError = document.getElementById("dismissError");
        const dismissConfirmBtn = document.getElementById("dismissConfirmBtn");
        const dismissCancelBtn = document.getElementById("dismissCancelBtn");

        let pendingFlagId = null;

        function openDismissModal(flagId) {
            pendingFlagId = flagId;
            dismissReasonInput.value = "";
            dismissError.style.display = "none";
            dismissModal.classList.add("active");
            dismissReasonInput.focus();
        }

        function closeDismissModal() {
            dismissModal.classList.remove("active");
            pendingFlagId = null;
        }

        dismissCancelBtn.addEventListener("click", closeDismissModal);
        dismissModal.addEventListener("click", function(e) {
            if (e.target === dismissModal) closeDismissModal();
        });

        document.querySelectorAll(".dismiss-flag-btn").forEach(function(button) {
            button.addEventListener("click", function() {
                const flagId = button.closest(".flag-row").dataset.flagId;
                openDismissModal(flagId);
            });
        });

        dismissConfirmBtn.addEventListener("click", async function() {
            const reason = dismissReasonInput.value.trim();

            if (!reason) {
                dismissError.style.display = "block";
                return;
            }

            const flagId = pendingFlagId;
            closeDismissModal();

            const formData = new FormData();
            formData.append("fraudFlagId", flagId);
            formData.append("reason", reason);

            const response = await fetch("@Url.Action("DismissFraudFlag", "LoanAssessment")", {
                method: "POST",
                headers: { "RequestVerificationToken": getAntiForgeryToken() },
                body: formData
            });

            const result = await response.json();
            if (result.success) {
                window.location.reload();
            } else {
                alert(result.message || "Could not dismiss the flag.");
            }
        });
    </script>
}