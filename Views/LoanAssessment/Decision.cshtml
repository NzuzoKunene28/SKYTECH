@model SkyTech.Models.ViewModels.AssessmentViewModel

@{
    ViewData["Title"] = "Final Decision";
    Layout = "~/Views/Shared/_MinimalLayout.cshtml";
    var app = Model.LoanApplication;
}

<style>
    :root {
        --blue: #5f9ea0;
        --blue-dark: #2d6b6d;
        --blue-deep: #1f4f50;
        --bg: #f0f4fc;
        --border: #dde6f5;
        --text: #0e1b35;
        --text-2: #4a5878;
        --text-m: #8a96b0;
        --red: #dc2626;
    }

    .assess-page {
        min-height: 80vh;
        background: var(--bg);
        padding: 45px 20px;
    }

    .assess-container {
        max-width: 900px;
        margin: auto;
    }

    .step-label {
        color: var(--blue-dark);
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-title {
        color: var(--text);
        font-size: 34px;
        font-weight: 750;
        margin: 7px 0;
    }

    .page-subtitle {
        color: var(--text-2);
        margin-bottom: 25px;
    }

    .result-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 12px 35px rgba(31, 79, 80, 0.07);
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        color: var(--text-2);
        border-bottom: 1px solid var(--border);
    }

        .summary-row:last-child {
            border-bottom: none;
        }

        .summary-row strong {
            color: var(--text);
        }

    .decision-notes {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        margin: 20px 0;
        font-family: inherit;
        min-height: 70px;
        box-sizing: border-box;
    }

    .decision-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .decision-button {
        border: none;
        padding: 13px 22px;
        border-radius: 10px;
        font-weight: 700;
        cursor: pointer;
        color: white;
    }

    .decision-approve {
        background: #198754;
    }

    .decision-reject {
        background: var(--red);
    }

    .decision-disburse {
        background: var(--blue-dark);
    }

    .decision-errors {
        background: #fde8e8;
        border: 1px solid #f0b7b7;
        color: var(--red);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 15px;
        font-size: 14px;
        display: none;
    }

    .back-btn {
        display: inline-block;
        background: white;
        color: var(--text-2);
        border: 1px solid var(--border);
        padding: 13px 24px;
        border-radius: 11px;
        font-weight: 600;
        text-decoration: none;
        margin-top: 20px;
    }

    /* ── Confirmation modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(14, 27, 53, 0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-box {
        background: white;
        border-radius: 22px;
        padding: 35px;
        max-width: 420px;
        width: 100%;
        box-shadow: 0 25px 60px rgba(31, 79, 80, 0.25);
        text-align: center;
    }

    .modal-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 700;
    }

    .modal-icon-approve {
        background: #e1f4e9;
        color: #198754;
    }

    .modal-icon-reject {
        background: #fde8e8;
        color: var(--red);
    }

    .modal-title {
        color: var(--text);
        font-size: 21px;
        font-weight: 750;
        margin-bottom: 10px;
    }

    .modal-text {
        color: var(--text-2);
        font-size: 14px;
        margin-bottom: 25px;
        line-height: 1.6;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .modal-btn {
        flex: 1;
        border: none;
        padding: 12px;
        border-radius: 10px;
        font-weight: 650;
        cursor: pointer;
        font-size: 14px;
    }

    .modal-btn-cancel {
        background: white;
        border: 1px solid var(--border);
        color: var(--text-2);
    }

    .modal-btn-confirm-approve {
        background: #198754;
        color: white;
    }

    .modal-btn-confirm-reject {
        background: var(--red);
        color: white;
    }
</style>

<div class="assess-page">
    <div class="assess-container">

        <div class="step-label">Step 3 of 3</div>
        <h1 class="page-title">Final Decision</h1>
        <p class="page-subtitle">
            Application #@app.LoanApplicationId — review the summary below, then record your decision.
        </p>

        <div class="result-card">

            <div class="summary-row">
                <span>Still meets credit threshold</span>
                <strong style="color: @(Model.StillMeetsCreditThreshold ? "#198754" : "var(--red)")">
                    @(Model.StillMeetsCreditThreshold ? "Yes" : "No")
                </strong>
            </div>

            <div class="summary-row">
                <span>Unresolved critical fraud flags</span>
                <strong style="color: @(Model.AnyUnresolvedCriticalFlags ? "var(--red)" : "#198754")">
                    @(Model.AnyUnresolvedCriticalFlags ? "Yes" : "None")
                </strong>
            </div>

            <div class="summary-row">
                <span>Requested Amount</span>
                <strong>@app.RequestedAmount.ToString("C")</strong>
            </div>

            <div class="summary-row">
                <span>Total Declared Collateral</span>
                <strong>@app.TotalDeclaredCollateralValue.ToString("C")</strong>
            </div>

            <div id="decisionErrors" class="decision-errors"></div>

            <textarea id="decisionNotes" class="decision-notes" placeholder="Optional notes about this decision..."></textarea>

            <div class="decision-actions">
                <button type="button" class="decision-button decision-approve decide-btn" data-decision="Approved">Approve</button>
                <button type="button" class="decision-button decision-reject decide-btn" data-decision="Rejected">Reject</button>
            </div>

            <a asp-action="FraudFlags" asp-route-id="@Model.LoanAssessmentId" class="back-btn">← Back</a>

        </div>

    </div>
</div>

<!-- Confirmation modal -->
<div class="modal-overlay" id="confirmModal">

    <div class="modal-box">

        <div class="modal-icon" id="modalIcon">!</div>

        <div class="modal-title" id="modalTitle">Confirm Decision</div>

        <p class="modal-text" id="modalText">
            Are you sure you want to proceed?
        </p>

        <div class="modal-actions">
            <button type="button" class="modal-btn modal-btn-cancel" id="modalCancelBtn">Cancel</button>
            <button type="button" class="modal-btn" id="modalConfirmBtn">Confirm</button>
        </div>

    </div>

</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const loanAssessmentId = @Model.LoanAssessmentId;
        let pendingDecision = null;

        function getAntiForgeryToken() {
            const input = document.querySelector('input[name="__RequestVerificationToken"]');
            return input ? input.value : "";
        }

        const modal = document.getElementById("confirmModal");
        const modalIcon = document.getElementById("modalIcon");
        const modalTitle = document.getElementById("modalTitle");
        const modalText = document.getElementById("modalText");
        const modalConfirmBtn = document.getElementById("modalConfirmBtn");
        const modalCancelBtn = document.getElementById("modalCancelBtn");

        function openModal(decision) {
            pendingDecision = decision;

            if (decision === "Approved") {
                modalIcon.className = "modal-icon modal-icon-approve";
                modalIcon.innerText = "✓";
                modalTitle.innerText = "Approve this application?";
                modalText.innerText = "This will mark the application as Approved. You can disburse the payment afterwards.";
                modalConfirmBtn.className = "modal-btn modal-btn-confirm-approve";
                modalConfirmBtn.innerText = "Approve";
            } else {
                modalIcon.className = "modal-icon modal-icon-reject";
                modalIcon.innerText = "!";
                modalTitle.innerText = "Reject this application?";
                modalText.innerText = "This will mark the application as Rejected. This action cannot be undone.";
                modalConfirmBtn.className = "modal-btn modal-btn-confirm-reject";
                modalConfirmBtn.innerText = "Reject";
            }

            modal.classList.add("active");
        }

        function closeModal() {
            modal.classList.remove("active");
            pendingDecision = null;
        }

        modalCancelBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", function(e) {
            if (e.target === modal) closeModal();
        });

        document.querySelectorAll(".decide-btn").forEach(function(button) {
            button.addEventListener("click", function() {
                openModal(button.dataset.decision);
            });
        });

        modalConfirmBtn.addEventListener("click", async function() {
            const decision = pendingDecision;
            if (!decision) return;

            closeModal();

            const notes = document.getElementById("decisionNotes").value;
            const errorsBox = document.getElementById("decisionErrors");
            errorsBox.style.display = "none";
            errorsBox.innerHTML = "";

            const formData = new FormData();
            formData.append("loanAssessmentId", loanAssessmentId);
            formData.append("decision", decision);
            formData.append("notes", notes);

            const response = await fetch("@Url.Action("Decide", "LoanAssessment")", {
                method: "POST",
                headers: { "RequestVerificationToken": getAntiForgeryToken() },
                body: formData
            });

            if (response.redirected) {
                window.location.href = response.url;
                return;
            }

            const result = await response.json().catch(() => null);
            if (result && result.errors) {
                errorsBox.innerHTML = result.errors.join("<br/>");
                errorsBox.style.display = "block";
            } else {
                alert("Could not record the decision.");
            }
        });
    </script>
}